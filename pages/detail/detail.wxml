<view class="page-bg detail-page">
  <!-- 骨架屏 -->
  <block wx:if="{{loading}}">
    <view class="skeleton detail-banner"></view>
    <view class="skeleton detail-info"></view>
  </block>

  <block wx:elif="{{product}}">
    <!-- 轮播图 -->
    <swiper class="banner" indicator-dots autoplay circular interval="3000"
            indicator-color="rgba(255,255,255,.5)" indicator-active-color="#fff">
      <swiper-item wx:for="{{product.pics}}" wx:key="index">
        <image mode="aspectFill" src="{{item}}" binderror="onImgError" data-src="{{item}}" catchtap="previewImage" data-url="{{item}}"></image>
      </swiper-item>
    </swiper>

    <!-- 商品信息 -->
    <view class="card info-card">
      <view class="price-row">
        <text class="price-num big">{{priceYuan}}</text>
        <text class="member-price">会员价 ¥{{memberYuan}}</text>
        <text class="price-old ml-auto">¥{{product.originalYuan}}</text>
      </view>
      <view class="goods-name title">{{product.name}}</view>
      <view class="goods-sub">{{product.subtitle}}</view>
      <view class="tag-row">
        <text class="tag-pill" wx:for="{{product.tags}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="meta-row">
        <text>产地：{{product.origin}}</text>
        <text>库存：{{product.stock}}{{product.unit}}</text>
        <text>已售{{product.salesText || product.salesVolume}}</text>
      </view>
    </view>

    <!-- 规格选择 -->
    <view class="card">
      <view class="spec-title">选择规格</view>
      <view class="spec-list">
        <view class="spec-chip {{selectedSpec === index ? 'active' : ''}}"
              wx:for="{{product.specs[0].values}}" wx:key="label"
              data-index="{{index}}" bindtap="selectSpec">
          {{item.label}} · ¥{{item.priceYuan}}
        </view>
      </view>
      <view class="spec-row">
        <text>数量</text>
        <view class="stepper">
          <view class="stepper-btn minus" bindtap="decrease">−</view>
          <view class="stepper-num">{{count}}</view>
          <view class="stepper-btn" bindtap="increase">+</view>
        </view>
      </view>
    </view>

    <!-- Tab：详情 / 评价 -->
    <view class="tab-bar">
      <view class="tab {{activeTab === 'detail' ? 'active' : ''}}" data-tab="detail" bindtap="switchTab">商品详情</view>
      <view class="tab {{activeTab === 'reviews' ? 'active' : ''}}" data-tab="reviews" bindtap="switchTab">用户评价（{{reviews.length}}）</view>
    </view>

    <!-- 商品详情 -->
    <block wx:if="{{activeTab === 'detail'}}">
      <view class="card">
        <view class="desc-title">产品介绍</view>
        <view class="desc-text">{{product.description}}</view>
        <image mode="widthFix" class="detail-img" wx:for="{{product.detailImages}}" wx:key="index"
               src="{{item}}" binderror="onImgError" data-src="{{item}}"
               catchtap="previewImage" data-url="{{item}}"></image>
      </view>

      <!-- 看了又看 -->
      <view class="card" wx:if="{{alsoLike.length > 0}}">
        <view class="desc-title">看了又看</view>
        <view class="alsolike-grid">
          <view class="alsolike-item" wx:for="{{alsoLike}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
            <image mode="aspectFill" src="{{item.pic}}" binderror="onImgError" data-src="{{item.pic}}"></image>
            <view class="ellipsis">{{item.name}}</view>
            <view class="price-red">¥{{item.priceYuan}}</view>
          </view>
        </view>
      </view>
    </block>

    <!-- 用户评价 -->
    <block wx:if="{{activeTab === 'reviews'}}">
      <!-- 评分汇总 -->
      <view class="card rating-summary" wx:if="{{reviews.length > 0}}">
        <view class="rating-left">
          <view class="rating-score">{{avgScore}}</view>
          <view class="rating-stars">★★★★★</view>
        </view>
        <view class="rating-right">
          <view>累计 {{reviewCount}} 条评价</view>
          <view class="rating-sub">新鲜 · 口感甜 · 包装好</view>
        </view>
      </view>
      <view class="card" wx:if="{{reviews.length === 0}}">
        <view class="empty-box">
          <image class="empty-img" src="/static/images/default.png" binderror="onImgError" data-src="/static/images/default.png"></image>
          <view class="empty-text">暂无评价，期待您的评价</view>
        </view>
      </view>
      <view class="card review-card" wx:for="{{reviews}}" wx:key="id">
        <view class="review-head">
          <image class="avatar" src="{{item.avatar}}" binderror="onImgError" data-src="{{item.avatar}}"></image>
          <view class="review-user">{{item.userName}}</view>
          <view class="stars">{{item.score}}星</view>
        </view>
        <view class="tag-row">
          <text class="tag-pill" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
        </view>
        <view class="review-content">{{item.content}}</view>
        <view class="review-imgs">
          <image mode="aspectFill" wx:for="{{item.images}}" wx:for-item="ri" wx:key="*this"
                 src="{{ri}}" binderror="onImgError" data-src="{{ri}}"
                 catchtap="previewImage" data-url="{{ri}}"></image>
        </view>
        <view class="review-time">{{item.createTimeText || ''}}</view>
      </view>
    </block>
  </block>

  <!-- 底部操作栏 -->
  <view class="bottom-bar action-bar" wx:if="{{product}}">
    <view class="action-icon" bindtap="toggleFavorite">
      <text class="{{isFavorite ? 'fav-active' : ''}}">♥</text>
      <view>收藏</view>
    </view>
    <view class="action-icon" bindtap="goCart">
      <text>🛒</text>
      <view>购物车</view>
    </view>
    <view class="btn-ghost cart-btn" bindtap="openSku">加入购物车</view>
    <view class="btn-primary buy-btn" bindtap="openSku">立即购买</view>
  </view>

  <!-- SKU 半屏规格弹层 -->
  <view class="sku-mask" wx:if="{{skuShow}}" bindtap="closeSku">
    <view class="sku-panel" catchtap="">
      <view class="sku-head">
        <image mode="aspectFill" class="sku-pic" src="{{product.pic}}" binderror="onImgError" data-src="{{product.pic}}"></image>
        <view class="sku-info">
          <view class="price-num">{{priceYuan}}</view>
          <view class="sku-stock">库存 {{product.specs[0].values[selectedSpec].stock}} {{product.unit}}</view>
        </view>
        <view class="sku-close" bindtap="closeSku">✕</view>
      </view>
      <view class="sku-spec-title">选择规格</view>
      <view class="spec-list">
        <view class="spec-chip {{selectedSpec === index ? 'active' : ''}}"
              wx:for="{{product.specs[0].values}}" wx:key="label"
              data-index="{{index}}" bindtap="selectSpec">
          {{item.label}} · ¥{{item.priceYuan}}
        </view>
      </view>
      <view class="sku-row">
        <text>数量</text>
        <view class="stepper">
          <view class="stepper-btn minus" bindtap="decrease">−</view>
          <view class="stepper-num">{{count}}</view>
          <view class="stepper-btn" bindtap="increase">+</view>
        </view>
      </view>
      <view class="sku-btns">
        <view class="btn-ghost cart-btn" bindtap="addToCart">加入购物车</view>
        <view class="btn-primary buy-btn" bindtap="confirmBuyNow">立即购买</view>
      </view>
    </view>
  </view>
</view>
