<view class="detail-page" wx:if="{{goods}}">
  <!-- 轮播图（点击全屏预览，指示器1/5） -->
  <swiper class="hero" indicator-dots autoplay interval="2500" circular indicator-color="rgba(0,0,0,.3)" indicator-active-color="#ff3b30" bindchange="onSwiperChange">
    <swiper-item wx:for="{{goods.pics}}" wx:key="*this">
      <pic src="{{item}}" mode="aspectFill" class="hero-img" bindtap="previewImage" data-src="{{item}}" data-urls="{{goods.pics}}"/>
    </swiper-item>
  </swiper>
  <view class="hero-counter">{{swiperIndex + 1}}/{{goods.pics.length}}</view>

  <!-- 价格信息 -->
  <view class="price-card card">
    <view class="price-row">
      <view class="price big">{{goods.priceYuan}}</view>
      <view class="price-origin">￥{{goods.originPriceYuan}}</view>
      <view class="vip-price">会员价 ￥{{goods.vipPriceYuan}}</view>
    </view>
    <view class="name">{{goods.name}}</view>
    <view class="sub muted">{{goods.subtitle}}</view>
    <view class="tags">
      <text class="tag" wx:for="{{goods.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
    </view>
    <view class="meta muted">产地：{{goods.origin}} · 单位：{{goods.unit}} · 已售{{goods.sells}}份 · 库存{{goods.stock}}份</view>
  </view>

  <!-- 会员卡 -->
  <view class="vip-card card" bindtap="goCart" style="display:none">
  </view>
  <view class="vip-banner card">
    <view class="vip-icon">👑</view>
    <view class="vip-info">
      <view class="vip-title">开通优享会员，本单享会员价 ￥{{goods.vipPriceYuan}}</view>
      <view class="vip-sub muted">全场95折 · 每月赠券 · 满39免配送费</view>
    </view>
    <view class="vip-go" bindtap="goVip">去开通 ›</view>
  </view>

  <!-- 安心检测 -->
  <view class="card assure">
    <view class="assure-title">🛡️ 优鲜安心检测</view>
    <view class="muted">100%第三方权威检测，坏果包赔，售后无忧</view>
  </view>

  <!-- 商品详情 -->
  <view class="card">
    <view class="section-title">商品详情</view>
    <view class="desc">{{goods.description}}</view>
    <view class="detail-imgs">
      <pic wx:for="{{goods.detailImages}}" wx:key="*this" src="{{item}}" mode="widthFix" class="detail-img" bindtap="previewImage" data-src="{{item}}" data-urls="{{goods.detailImages}}"/>
    </view>
  </view>

  <!-- 评价：评分汇总 + 精选评价 + 查看全部 -->
  <view class="card">
    <view class="section-title">用户评价 ({{reviewCount}})</view>
    <view class="rating-summary">
      <view class="rating-score">{{avgScore}}</view>
      <view class="rating-stars">
        <text wx:for="{{[1,2,3,4,5]}}" wx:for-item="s" wx:key="*this" class="star {{s <= avgScore ? 'on' : ''}}">★</text>
      </view>
      <view class="muted">共{{reviewCount}}条评价</view>
    </view>
    <view class="review" wx:for="{{showAllReviews ? reviews : reviews.slice(0, 3)}}" wx:key="id">
      <view class="review-head">
        <pic src="{{item.avatar}}" mode="aspectFill" radius="50%" class="avatar"/>
        <view class="review-user">{{item.userName}}</view>
        <view class="stars">
          <text wx:for="{{item.scoreArr}}" wx:for-item="star" wx:key="*this" class="star {{star ? 'on' : ''}}">★</text>
        </view>
      </view>
      <view class="review-content">{{item.content}}</view>
      <view class="review-tags">
        <text class="tag tag-green" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
      </view>
      <view class="muted review-time">{{item.createTime}}</view>
    </view>
    <view class="empty" wx:if="{{!reviews.length}}">
      <view class="empty-img">💬</view>
      <view class="empty-text">暂无评价，来做第一个评价的人吧</view>
    </view>
    <view class="review-more" wx:if="{{reviews.length > 3}}" bindtap="toggleAllReviews">{{showAllReviews ? '收起评价' : '查看全部评价 ›'}}</view>
  </view>

  <!-- 看了又看 -->
  <view class="card" wx:if="{{related.length}}">
    <view class="section-title">看了又看</view>
    <scroll-view scroll-x class="rel-scroll">
      <view class="rel-item" wx:for="{{related}}" wx:key="sku" bindtap="goDetail" data-sku="{{item.sku}}">
        <pic src="{{item.pic}}" mode="aspectFill" radius="10rpx" class="rel-pic"/>
        <view class="rel-name">{{item.name}}</view>
        <view class="price-sm primary">￥{{item.priceYuan}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部操作栏 -->
  <view class="footer-bar detail-foot">
    <view class="foot-icon" bindtap="goCart">
      <view class="cart-icon">🛒</view>
      <view class="foot-label">购物车</view>
      <view class="badge" wx:if="{{cartCount > 0}}">{{cartCount > 99 ? '99+' : cartCount}}</view>
    </view>
    <view class="foot-icon" bindtap="toggleCollect">
      <view class="cart-icon">{{isCollect ? '❤️' : '🤍'}}</view>
      <view class="foot-label">收藏</view>
    </view>
    <view class="foot-btn add" bindtap="openSpec">加入购物车</view>
    <view class="foot-btn buy" bindtap="openSpec">立即购买</view>
  </view>

  <!-- 规格选择弹层 -->
  <view class="mask" wx:if="{{showSpec}}" bindtap="closeSpec"></view>
  <view class="spec-sheet" wx:if="{{showSpec}}">
    <view class="spec-head">
      <pic src="{{goods.pic}}" mode="aspectFill" radius="12rpx" class="spec-pic"/>
      <view class="spec-info">
        <view class="price big primary">￥{{finalPriceYuan}}</view>
        <view class="muted">库存 {{goods.stock}} 份</view>
        <view class="muted">已选：{{selSpec['规格']}} · {{selSpec['包装']}}</view>
      </view>
      <view class="spec-close" bindtap="closeSpec">✕</view>
    </view>

    <view class="spec-group" wx:for="{{specValues}}" wx:for-item="grp" wx:for-index="grpIndex" wx:key="name">
      <view class="spec-gname">{{grp.name}}</view>
      <view class="spec-options">
        <view class="spec-opt {{item.selected ? 'on' : ''}}" wx:for="{{grp.values}}" wx:for-item="v" wx:key="label"
              bindtap="pickSpec" data-group="{{grpIndex}}" data-idx="{{index}}">{{v.label}}</view>
      </view>
    </view>

    <view class="spec-bottom">
      <view class="stepper">
        <view class="minus" bindtap="changeCount" data-d="-1">−</view>
        <view class="num">{{count}}</view>
        <view class="plus" bindtap="changeCount" data-d="1">＋</view>
      </view>
      <view class="foot-btn add spec-add" bindtap="confirmAddCart">加入购物车</view>
      <view class="foot-btn buy spec-buy" bindtap="buyNow">立即购买</view>
    </view>
  </view>

  <!-- 骨架屏 -->
  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk-row"><view class="sk-img" style="width:100%;height:400rpx"></view></view>
    <view class="sk-row"><view class="sk-body"><view class="sk-line" style="width:60%"></view><view class="sk-line" style="width:40%"></view></view></view>
  </view>
</view>
