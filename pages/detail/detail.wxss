.detail-page { padding-bottom: 160rpx; }
.hero { width: 100%; height: 600rpx; }
.hero-img { width: 100%; height: 100%; }

.price-card { margin-top: -30rpx; position: relative; z-index: 2; border-radius: 24rpx; padding: 24rpx; }
.price-row { display: flex; align-items: baseline; }
.price.big { font-size: 44rpx; }
.price-origin { font-size: 26rpx; color: #bbb; text-decoration: line-through; margin-left: 12rpx; }
.vip-price { font-size: 22rpx; color: #ff8c00; margin-left: 12rpx; }
.name { font-size: 32rpx; font-weight: 700; margin-top: 12rpx; line-height: 1.4; }
.sub { margin-top: 6rpx; font-size: 24rpx; }
.tags { margin-top: 10rpx; }
.meta { font-size: 22rpx; margin-top: 10rpx; }

.vip-banner { display: flex; align-items: center; padding: 18rpx 24rpx; }
.vip-icon { font-size: 44rpx; margin-right: 14rpx; }
.vip-info { flex: 1; }
.vip-title { font-size: 26rpx; font-weight: 600; }
.vip-sub { font-size: 22rpx; margin-top: 4rpx; }
.vip-go { color: #ff8c00; font-size: 24rpx; }

.assure { padding: 18rpx 24rpx; }
.assure-title { font-size: 26rpx; font-weight: 600; margin-bottom: 4rpx; }

.section-title { font-size: 28rpx; font-weight: 700; margin-bottom: 12rpx; }
.desc { font-size: 26rpx; line-height: 1.7; color: #444; }
.detail-imgs { margin-top: 16rpx; }
.detail-img { width: 100%; border-radius: 12rpx; margin-bottom: 10rpx; }

.review { padding: 14rpx 0; border-bottom: 1rpx solid #f2f2f2; }
.review-head { display: flex; align-items: center; }
.avatar { width: 48rpx; height: 48rpx; border-radius: 50%; margin-right: 12rpx; }
.review-user { font-size: 26rpx; font-weight: 600; margin-right: 12rpx; }
.stars { font-size: 22rpx; color: #ddd; }
.star.on { color: #ffb400; }
.review-content { font-size: 26rpx; margin-top: 8rpx; line-height: 1.5; }
.review-tags { margin-top: 6rpx; }
.review-time { font-size: 20rpx; margin-top: 4rpx; }

.rel-scroll { white-space: nowrap; }
.rel-item { display: inline-block; width: 160rpx; margin-right: 14rpx; text-align: center; }
.rel-pic { width: 160rpx; height: 160rpx; }
.rel-name { font-size: 22rpx; margin-top: 6rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* 底部栏 */
.detail-foot { gap: 12rpx; }
.foot-icon { display: flex; flex-direction: column; align-items: center; width: 90rpx; position: relative; }
.cart-icon { font-size: 40rpx; }
.foot-label { font-size: 20rpx; color: #666; }
.foot-btn { flex: 1; text-align: center; padding: 20rpx 0; border-radius: 44rpx; font-size: 28rpx; font-weight: 600; }
.foot-btn.add { background: #ffd9d6; color: #ff3b30; }
.foot-btn.buy { background: linear-gradient(90deg,#ff5b4f,#ff3b30); color: #fff; }

/* 规格弹层 */
.mask { position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 200; }
.spec-sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 24rpx; z-index: 201; max-height: 80vh; overflow-y: auto; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.spec-head { display: flex; align-items: center; position: relative; }
.spec-pic { width: 140rpx; height: 140rpx; margin-right: 16rpx; }
.spec-info { flex: 1; }
.spec-close { position: absolute; right: 0; top: 0; font-size: 30rpx; color: #999; padding: 8rpx 12rpx; }
.spec-group { margin-top: 20rpx; }
.spec-gname { font-size: 28rpx; font-weight: 700; margin-bottom: 12rpx; }
.spec-options { display: flex; flex-wrap: wrap; }
.spec-opt { padding: 10rpx 28rpx; border-radius: 32rpx; background: #f4f5f7; font-size: 24rpx; margin: 0 12rpx 12rpx 0; color: #555; }
.spec-opt.on { background: #fff1f0; color: #ff3b30; font-weight: 600; border: 1rpx solid #ff3b30; }
.spec-bottom { display: flex; align-items: center; margin-top: 20rpx; gap: 16rpx; }
.spec-add { flex: 1; }
.spec-buy { flex: 1; }

.hero-counter { position: absolute; right: 16rpx; bottom: 16rpx; background: rgba(0,0,0,.45); color: #fff; font-size: 20rpx; padding: 2rpx 14rpx; border-radius: 16rpx; }
.hero { position: relative; }
.rating-summary { display: flex; align-items: center; gap: 12rpx; padding: 10rpx 0 14rpx; border-bottom: 1rpx solid #f2f2f2; margin-bottom: 10rpx; }
.rating-score { font-size: 36rpx; font-weight: 700; color: #ffb400; }
.rating-stars { font-size: 22rpx; }
.review-more { text-align: center; color: #ff3b30; font-size: 24rpx; padding: 12rpx 0; }
