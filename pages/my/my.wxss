/* 个人信息页样式 */
.my-header {
  background: linear-gradient(135deg, #e4393c, #ff6b6b); color: #fff;
  padding: 40rpx 32rpx; text-align: center; border-radius: 0 0 24rpx 24rpx;
}
.my-avatar { width: 96rpx; height: 96rpx; border-radius: 50%; border: 3rpx solid #fff; background: #fff; margin: 0 auto; display: block; }
.my-name { font-size: 32rpx; font-weight: 800; margin-top: 12rpx; }
.my-level { font-size: 22rpx; opacity: .9; }

.my-menu-item { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.my-menu-item:last-child { border-bottom: none; }
.menu-icon { width: 44rpx; height: 44rpx; margin-right: 16rpx; }
.menu-name { font-size: 28rpx; }
.menu-arrow { color: #ccc; font-size: 32rpx; }
.nav-btns { display: flex; gap: 16rpx; }
.nav-btn { flex: 1; text-align: center; padding: 14rpx; }
.section-title-sm { font-size: 30rpx; font-weight: 700; margin-bottom: 12rpx; }
