.collect-page { padding-bottom: 60rpx; }
.grid { display: flex; flex-wrap: wrap; padding: 16rpx; gap: 16rpx; }
.grid-card {
  width: calc(50% - 8rpx); background: #fff; border-radius: 16rpx; padding: 16rpx;
}
.grid-img { width: 100%; height: 200rpx; border-radius: 12rpx; }
.grid-name { font-size: 26rpx; margin-top: 10rpx; }
.grid-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.grid-actions { display: flex; gap: 8rpx; }
.mini-btn { padding: 4rpx 14rpx; border-radius: 999rpx; background: #f2f3f5; font-size: 20rpx; color: #555; }
.mini-btn.danger { color: #e4393c; border: 2rpx solid #e4393c; }
.go-btn { width: 240rpx; margin-top: 10rpx; }
.grid-skel { width: calc(50% - 8rpx); height: 240rpx; margin: 16rpx; border-radius: 16rpx; }
