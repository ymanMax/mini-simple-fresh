<!-- 收藏列表：网格卡片、左滑删除、点击跳详情、空态 -->
<view class="page-wrap collect-page">
  <view wx:if="{{loading}}" class="skeleton"><view class="sk-block" style="height:140rpx"></view><view class="sk-block" style="height:140rpx"></view></view>

  <block wx:else>
    <view wx:if="{{favorites.length==0}}" class="empty">
      <image class="empty-img" src="/images/icons/like.png" binderror="onImgError" data-key="emptyImg"></image>
      <view class="empty-title">还没有收藏的商品</view>
      <view class="empty-sub">在商品详情页点击心形按钮收藏</view>
      <view class="btn-primary go-shop-btn" bindtap="goShopping">去逛逛</view>
    </view>

    <view class="grid">
      <view class="grid-item {{swipedId==item.id?'swiped':''}}" wx:for="{{favorites}}" wx:key="id"
            bindtap="goDetail" data-id="{{item.id}}" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
        <view class="item-delete" catchtap="unfavorite" data-id="{{item.id}}">删除</view>
        <image class="grid-img" src="{{item.pic}}" mode="aspectFill" binderror="onImgError" data-key="favorites[{{index}}].pic"></image>
        <view class="grid-name">{{item.name}}</view>
        <view class="row-between">
          <view class="price-sm">¥{{item.price/100}}</view>
          <view class="cancel-btn" catchtap="unfavorite" data-id="{{item.id}}">取消</view>
        </view>
      </view>
    </view>
  </block>
</view>
