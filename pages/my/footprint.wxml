<!-- 浏览足迹：按日期分组、横滑卡片、单条删除、全部清空、空态 -->
<view class="page-wrap footprint-page">
  <view wx:if="{{loading}}" class="skeleton"><view class="sk-block" style="height:140rpx"></view><view class="sk-block" style="height:140rpx"></view></view>

  <block wx:else>
    <view wx:if="{{all.length==0}}" class="empty">
      <image class="empty-img" src="/images/icons/see.png" binderror="onImgError" data-key="emptyImg"></image>
      <view class="empty-title">暂无浏览记录</view>
      <view class="empty-sub">浏览商品后自动记录</view>
      <view class="btn-primary go-shop-btn" bindtap="goShopping">去逛逛</view>
    </view>

    <view wx:if="{{all.length>0}}" class="clear-bar">
      <view class="clear-link" bindtap="clearAll">清空全部</view>
    </view>

    <view class="day-group" wx:for="{{groups}}" wx:key="label">
      <view class="day-label">{{item.label}}</view>
      <scroll-view scroll-x class="h-scroll" style="padding:0 16rpx">
        <view class="h-scroll-item fp-card" wx:for="{{item.items}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
          <image class="fp-img" src="{{item.pic}}" mode="aspectFill" binderror="onImgError" data-key="footprint[{{index}}].pic"></image>
          <view class="fp-name">{{item.name}}</view>
          <view class="row-between">
            <view class="price-sm">¥{{item.price/100}}</view>
            <view class="fp-del" catchtap="removeOne" data-id="{{item.id}}">删除</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>
</view>
