.search-page { padding-bottom: 40rpx; }

/* 顶部搜索 */
.top-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
}
.input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f0f1f3;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}
.s-icon { font-size: 26rpx; margin-right: 10rpx; opacity: 0.6; }
.input-wrap input { flex: 1; font-size: 28rpx; }
.clear { color: #b0b0b0; font-size: 24rpx; padding: 0 10rpx; }
.search-btn { color: #e93b3d; font-size: 30rpx; padding: 0 20rpx; }

.block-title { font-size: 28rpx; font-weight: bold; margin-bottom: 16rpx; }
.hot-words { display: flex; flex-wrap: wrap; }
.hot-word {
  background: #f0f1f3;
  color: #555;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  margin: 0 12rpx 12rpx 0;
  display: inline-flex;
  align-items: center;
}
.hot-word.gray { background: #f7f7f7; }
.del { margin-left: 10rpx; color: #b0b0b0; font-size: 20rpx; }
.clear-history { font-size: 24rpx; color: #b0b0b0; font-weight: normal; }

/* 联想 */
.sug-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}
.sug-item:last-child { border-bottom: none; }
.sug-item image { width: 80rpx; height: 80rpx; border-radius: 10rpx; }
.sug-info { margin-left: 20rpx; }
.sug-name { font-size: 28rpx; }
.sug-price { color: #e93b3d; font-size: 24rpx; margin-top: 4rpx; }

/* 排序栏 */
.sort-bar {
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f2f2f2;
}
.sort-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #555;
  padding: 8rpx 0;
}
.sort-item.active { color: #e93b3d; font-weight: bold; }
.result-tip { padding: 16rpx 24rpx; font-size: 24rpx; color: #b0b0b0; }

.goods-card { margin: 12rpx 24rpx; }
.add-btn {
  width: 52rpx; height: 52rpx;
  line-height: 48rpx; text-align: center;
  background: #e93b3d; color: #fff;
  border-radius: 50%; font-size: 36rpx; font-weight: bold;
}
