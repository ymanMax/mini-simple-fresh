.search-page { min-height: 100vh; padding-bottom: 40rpx; }
.search-top { display: flex; align-items: center; padding: 14rpx 24rpx; background: #fff; }
.search-box { flex: 1; display: flex; align-items: center; background: #f0f1f3; border-radius: 36rpx; padding: 10rpx 20rpx; }
.search-icon { font-size: 24rpx; margin-right: 10rpx; }
.search-input { flex: 1; font-size: 26rpx; }
.search-clear { font-size: 24rpx; color: #bbb; padding: 0 8rpx; }
.search-btn { color: #ff3b30; font-size: 28rpx; margin-left: 16rpx; padding: 0 8rpx; }

.block { background: #fff; margin: 16rpx 24rpx; border-radius: 16rpx; padding: 20rpx; }
.block-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.block-title { font-size: 28rpx; font-weight: 700; }
.block-clear { font-size: 24rpx; color: #999; }
.tag-list { display: flex; flex-wrap: wrap; }
.h-tag { background: #f4f5f7; border-radius: 28rpx; padding: 10rpx 24rpx; font-size: 24rpx; margin: 0 12rpx 12rpx 0; color: #555; }
.h-del { color: #bbb; font-size: 20rpx; }

.suggest-list { background: #fff; margin: 16rpx 24rpx; border-radius: 16rpx; overflow: hidden; }
.suggest-item { display: flex; align-items: center; padding: 14rpx 20rpx; border-bottom: 1rpx solid #f0f0f0; }
.s-pic { width: 70rpx; height: 70rpx; margin-right: 16rpx; }
.s-name { flex: 1; font-size: 26rpx; }

.sort-bar { display: flex; background: #fff; padding: 12rpx 24rpx; position: sticky; top: 0; z-index: 10; }
.sort-item { flex: 1; text-align: center; font-size: 26rpx; color: #666; padding: 10rpx 0; }
.sort-item.on { color: #ff3b30; font-weight: 700; }

.goods-card { margin: 16rpx 24rpx 0; }
.goods-card .pic { width: 150rpx; height: 150rpx; }
.goods-card .bottom { display: flex; align-items: center; justify-content: space-between; margin-top: auto; }
.cell-add { width: 44rpx; height: 44rpx; border-radius: 50%; background: #ff3b30; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 30rpx; }
.nomore { text-align: center; color: #bbb; font-size: 24rpx; padding: 30rpx 0; }
.loading-more { text-align: center; color: #999; font-size: 24rpx; padding: 20rpx 0; }
