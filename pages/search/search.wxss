.top-bar {
  display: flex; align-items: center; padding: 16rpx 24rpx;
  background: #fff; position: sticky; top: 0; z-index: 20;
}
.search-box {
  flex: 1; display: flex; align-items: center; background: #f2f3f5;
  border-radius: 999rpx; padding: 12rpx 24rpx;
}
.search-icon { width: 30rpx; height: 30rpx; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 28rpx; }
.clear-kw { color: #999; padding: 0 10rpx; }
.cancel { color: #e4393c; margin-left: 16rpx; font-size: 28rpx; }

.page-content { padding-bottom: 60rpx; }

.card-section { background: #fff; margin: 16rpx 24rpx; border-radius: 16rpx; padding: 24rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; font-weight: 600; font-size: 28rpx; margin-bottom: 16rpx; }
.head-icon { width: 32rpx; height: 32rpx; }

.tag-wrap { display: flex; flex-wrap: wrap; gap: 16rpx; }
.hist-tag, .hot-tag {
  padding: 10rpx 24rpx; background: #f2f3f5; border-radius: 999rpx;
  font-size: 26rpx; color: #555;
}
.hist-del { margin-left: 10rpx; color: #999; }

.suggest-list { background: #fff; }
.suggest-item {
  display: flex; align-items: center; padding: 16rpx 24rpx;
  border-bottom: 2rpx solid #f5f6f7;
}
.suggest-img { width: 90rpx; height: 90rpx; border-radius: 10rpx; }
.suggest-info { margin-left: 20rpx; }

.sort-bar {
  display: flex; background: #fff; padding: 16rpx 24rpx;
  position: sticky; top: 0; z-index: 10;
}
.sort-item { margin-right: 32rpx; font-size: 26rpx; color: #666; }
.sort-item.active { color: #e4393c; font-weight: 600; }

.price-box { display: flex; align-items: baseline; gap: 10rpx; }
.sales { color: #999; font-size: 22rpx; }
.list-footer { text-align: center; color: #999; padding: 30rpx; font-size: 24rpx; }
