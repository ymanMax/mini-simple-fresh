/* 搜索页样式 */
.search-page { padding-bottom: 40rpx; }
.top-bar {
  display: flex; align-items: center; padding: 16rpx 24rpx; background: #fff;
  position: sticky; top: 0; z-index: 10; box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.04);
}
.search-box {
  flex: 1; display: flex; align-items: center; background: #f2f3f5;
  border-radius: 999rpx; padding: 0 20rpx; height: 72rpx;
}
.search-icon { width: 30rpx; height: 30rpx; margin-right: 10rpx; }
.search-input { flex: 1; font-size: 26rpx; }
.search-clear { width: 40rpx; height: 40rpx; text-align: center; line-height: 40rpx; color: #999; font-size: 30rpx; }
.search-btn { color: #e4393c; font-size: 28rpx; padding: 0 16rpx; font-weight: 600; }

.tag-row { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 8rpx 0; }
.history-tag, .hot-tag {
  padding: 10rpx 24rpx; background: #f2f3f5; border-radius: 999rpx; font-size: 24rpx;
  display: inline-flex; align-items: center;
}
.history-del { margin-left: 8rpx; color: #999; font-size: 24rpx; }

.suggest-item { display: flex; align-items: center; padding: 12rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.suggest-item:last-child { border-bottom: none; }
.suggest-img { width: 72rpx; height: 72rpx; border-radius: 8rpx; margin-right: 12rpx; background: #f2f3f5; }

.sort-bar {
  display: flex; background: #fff; padding: 12rpx 24rpx; position: sticky; top: 0; z-index: 10;
}
.sort-item { flex: 1; text-align: center; font-size: 26rpx; color: #666; padding: 8rpx 0; }
.sort-item.active { color: #e4393c; font-weight: 700; border-bottom: 3rpx solid #e4393c; }

.add-btn {
  width: 52rpx; height: 52rpx; border-radius: 50%; background: #e4393c; color: #fff;
  display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: bold;
}
.nomore { text-align: center; color: #999; font-size: 24rpx; padding: 24rpx; }
.section-title-sm { font-size: 30rpx; font-weight: 700; }
