<view class="search-page">
  <!-- 顶部搜索框 -->
  <view class="top-bar">
    <view class="input-wrap">
      <view class="s-icon">🔍</view>
      <input
        value="{{keyword}}"
        placeholder="搜索商品名称，如：车厘子 / 酸奶"
        confirm-type="search"
        bindinput="onInput"
        bindconfirm="doSearch"
        focus="{{!searching}}"
      />
      <view class="clear" wx:if="{{keyword}}" bindtap="clearKeyword">✕</view>
    </view>
    <view class="search-btn" bindtap="doSearch">搜索</view>
  </view>

  <!-- 未搜索：历史 + 热门 + 联想 -->
  <block wx:if="{{!searching}}">
    <!-- 实时联想 -->
    <view class="suggest card" wx:if="{{suggest.length}}">
      <view class="sug-item" wx:for="{{suggest}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
        <image src="{{item.pic}}" mode="aspectFill" binderror="imgError" data-list="suggest" data-index="{{index}}" data-field="pic"></image>
        <view class="sug-info">
          <view class="sug-name">{{item.name}}</view>
          <view class="sug-price">￥{{item.minPriceYuan}} / {{item.unit}}</view>
        </view>
      </view>
    </view>

    <!-- 热门搜索 -->
    <view class="card" wx:if="{{!suggest.length}}">
      <view class="block-title">🔥 热门搜索</view>
      <view class="hot-words">
        <text class="hot-word" wx:for="{{hotWords}}" wx:key="*this" data-word="{{item}}" bindtap="tapHot">{{item}}</text>
      </view>
    </view>

    <!-- 历史搜索 -->
    <view class="card" wx:if="{{history.length && !suggest.length}}">
      <view class="block-title flex-between">
        <text>🕘 历史搜索</text>
        <text class="clear-history" bindtap="clearHistory">清空</text>
      </view>
      <view class="hot-words">
        <text class="hot-word gray" wx:for="{{history}}" wx:key="*this">
          <text data-word="{{item}}" bindtap="tapHot">{{item}}</text>
          <text class="del" data-word="{{item}}" bindtap="removeHistory">✕</text>
        </text>
      </view>
    </view>
  </block>

  <!-- 搜索结果 -->
  <block wx:if="{{searching}}">
    <!-- 排序栏 -->
    <view class="sort-bar">
      <view class="sort-item {{sort==='default'?'active':''}}" data-sort="default" bindtap="setSort">综合</view>
      <view class="sort-item {{sort==='sells'?'active':''}}" data-sort="sells" bindtap="setSort">销量</view>
      <view class="sort-item {{sort==='price_asc'?'active':''}}" data-sort="price_asc" bindtap="setSort">价格↑</view>
      <view class="sort-item {{sort==='price_desc'?'active':''}}" data-sort="price_desc" bindtap="setSort">价格↓</view>
    </view>

    <view class="result-tip">共找到 {{total}} 件与「{{keyword}}」相关的商品</view>

    <block wx:if="{{results.length}}">
      <view class="goods-card" wx:for="{{results}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
        <image class="g-pic" src="{{item.pic}}" mode="aspectFill" binderror="imgError" data-list="results" data-index="{{index}}" data-field="pic"></image>
        <view class="g-info">
          <view class="g-name">{{item.name}}</view>
          <view class="g-sub">{{item.subtitle}} · 销量{{item.numberSells}}</view>
          <view class="g-bottom">
            <view class="price price-big">￥{{item.minPriceYuan}}</view>
            <view class="price-origin">￥{{item.originalPriceYuan}}</view>
            <view class="add-btn" catchtap="addCart" data-id="{{item.id}}">＋</view>
          </view>
        </view>
      </view>
      <view class="list-end" wx:if="{{!hasMore}}">—— 没有更多了 ~ ——</view>
      <view class="list-end" wx:if="{{hasMore}}">上拉加载更多</view>
    </block>

    <!-- 结果空态 -->
    <view class="empty-page" wx:if="{{!results.length && !loading}}">
      <image src="/images/empty-order.jpg"></image>
      <view class="empty-title">没有找到相关商品</view>
      <view class="empty-desc">换个关键词试试吧</view>
    </view>
  </block>
</view>
