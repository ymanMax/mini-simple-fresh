<!-- 优惠券：领券中心 + 我的优惠券 -->
<view class="page-wrap coupon-page">
  <!-- 顶部Tab -->
  <view class="top-tabs">
    <view class="top-tab {{tab==0?'active':''}}" bindtap="switchTab" data-tab="0">领券中心</view>
    <view class="top-tab {{tab==1?'active':''}}" bindtap="switchTab" data-tab="1">我的优惠券</view>
  </view>

  <view wx:if="{{loading}}" class="skeleton">
    <view class="sk-block" style="height:140rpx"></view>
    <view class="sk-block" style="height:140rpx"></view>
    <view class="sk-block" style="height:140rpx"></view>
  </view>

  <!-- 领券中心 -->
  <block wx:if="{{tab==0}}">
    <view wx:if="{{center.length==0 && !loading}}" class="empty">
      <image class="empty-img" src="/images/default.png" binderror="onImgError" data-key="emptyImg"></image>
      <view class="empty-title">暂无优惠券</view>
    </view>
    <view class="coupon-card" wx:for="{{center}}" wx:key="id">
      <view class="coupon-left">
        <view class="coupon-amount">{{item.amountText}}</view>
        <view class="coupon-name">{{item.name}}</view>
      </view>
      <view class="coupon-right">
        <view class="muted small">{{item.scope}} · 满{{item.threshold/100}}可用</view>
        <view class="muted small">有效期至 {{item.expireTime}}</view>
        <view class="muted small">剩余 {{item.remain}} 张 / 共 {{item.total}} 张</view>
      </view>
      <view class="coupon-action" bindtap="claim" data-id="{{item.id}}">立即领取</view>
    </view>
  </block>

  <!-- 我的优惠券 -->
  <block wx:else>
    <view class="my-tabs">
      <view class="my-tab {{myTab==1?'active':''}}" bindtap="switchMyTab" data-tab="1">未使用</view>
      <view class="my-tab {{myTab==2?'active':''}}" bindtap="switchMyTab" data-tab="2">已使用</view>
      <view class="my-tab {{myTab==3?'active':''}}" bindtap="switchMyTab" data-tab="3">已过期</view>
    </view>

    <view wx:if="{{list.length==0 && !loading}}" class="empty">
      <image class="empty-img" src="/images/default.png" binderror="onImgError" data-key="emptyImg"></image>
      <view class="empty-title">暂无优惠券</view>
      <view class="empty-sub">去领券中心领取吧</view>
      <view class="btn-primary go-shop-btn" bindtap="switchTab" data-tab="0">去领券</view>
    </view>

    <view class="coupon-card {{item.status!=1?'used':''}}" wx:for="{{list}}" wx:key="id">
      <view class="coupon-left">
        <view class="coupon-amount">{{item.amountText}}</view>
        <view class="coupon-name">{{item.name}}</view>
      </view>
      <view class="coupon-right">
        <view class="muted small">{{item.scope}} · 满{{item.threshold/100}}可用</view>
        <view class="muted small">有效期至 {{item.expireTime}}</view>
        <view class="muted small">来源：{{item.source}}</view>
      </view>
      <view wx:if="{{item.status==1}}" class="coupon-action" bindtap="useCoupon">去使用</view>
      <view wx:else class="coupon-action disabled">{{item.status==2?'已使用':'已过期'}}</view>
    </view>
  </block>
</view>
