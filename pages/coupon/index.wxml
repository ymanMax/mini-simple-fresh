<view class="coupon-page">
  <!-- Tabs -->
  <view class="tabs">
    <view class="tab {{activeTab === item.key ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="switchTab">{{item.name}}</view>
  </view>

  <!-- 领券中心 -->
  <block wx:if="{{activeTab === 'center'}}">
    <view class="coupon-card" wx:for="{{centerList}}" wx:key="id">
      <view class="cc-left {{item.claimed ? 'claimed' : ''}}">
        <view class="cc-amount">{{item.amountLabel}}</view>
        <view class="cc-rule">{{item.ruleLabel}}</view>
      </view>
      <view class="cc-mid">
        <view class="cc-name">{{item.name}}</view>
        <view class="cc-scope">{{item.scope}} · {{item.source}}</view>
        <view class="cc-expire">有效期 {{item.expireDays}} 天 · 剩余 {{item.left}}/{{item.total}} 张</view>
      </view>
      <view class="cc-btn {{item.claimed ? 'claimed' : ''}}" data-id="{{item.id}}" bindtap="claim">
        {{item.claimed ? '已领取' : '立即领取'}}
      </view>
    </view>
    <view class="empty-page" wx:if="{{!centerList.length && !loading}}">
      <image src="/images/empty-order.jpg"></image>
      <view class="empty-title">暂无可领取的优惠券</view>
    </view>
  </block>

  <!-- 我的优惠券 -->
  <block wx:if="{{activeTab !== 'center'}}">
    <view class="coupon-card mine" wx:for="{{myList}}" wx:key="id">
      <view class="cc-left {{item.status !== 1 ? 'off' : ''}}">
        <view class="cc-amount">{{item.amountLabel}}</view>
        <view class="cc-rule">{{item.ruleLabel}}</view>
      </view>
      <view class="cc-mid">
        <view class="cc-name">{{item.name}}</view>
        <view class="cc-scope">{{item.scope}} · {{item.source}}</view>
        <view class="cc-expire">有效期 {{item.expireDays}} 天</view>
      </view>
      <view class="cc-btn {{item.status !== 1 ? 'off' : ''}}" bindtap="goUse">
        {{item.status === 1 ? '去使用' : (item.status === 2 ? '已使用' : '已过期')}}
      </view>
    </view>
    <view class="empty-page" wx:if="{{!myList.length && !loading}}">
      <image src="/images/empty-order.jpg"></image>
      <view class="empty-title">暂无优惠券</view>
      <view class="empty-desc">去领券中心领取吧</view>
      <view class="empty-btn" bindtap="goCenter">去领券</view>
    </view>
  </block>

  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk-row"><view class="sk-line w80"></view></view>
    <view class="sk-row"><view class="sk-line w80"></view></view>
  </view>
</view>
