<!-- 消息中心：类型Tab、相对时间、未读红点、全部已读、分页、3秒延迟推送、关联跳转 -->
<view class="page-wrap">
  <view class="top-tabs">
    <view class="top-tab {{activeTab==item.key?'active':''}}" wx:for="{{tabs}}" wx:key="key" bindtap="switchTab" data-key="{{item.key}}">{{item.name}}</view>
    <view class="mark-all" bindtap="markAllRead">全部已读</view>
  </view>

  <view wx:if="{{loading}}" class="skeleton"><view class="sk-block" style="height:140rpx"></view><view class="sk-block" style="height:140rpx"></view></view>

  <block wx:else>
    <view wx:if="{{list.length==0}}" class="empty">
      <image class="empty-img" src="/images/icons/message_normal.png" binderror="onImgError" data-key="emptyImg"></image>
      <view class="empty-title">暂无消息</view>
    </view>

    <view class="msg-card {{!item.isRead?'unread':''}}" wx:for="{{list}}" wx:key="id" bindtap="tapMessage" data-id="{{item.id}}">
      <image class="msg-icon" src="{{item.msgIcon}}" binderror="onImgError" data-key="msgIcon{{index}}"></image>
      <view class="flex-1">
        <view class="row-between">
          <view class="msg-title">{{item.title}}</view>
          <view class="msg-dot" wx:if="{{!item.isRead}}"></view>
        </view>
        <view class="msg-content">{{item.content}}</view>
        <view class="muted small msg-time">{{item.relativeText}} · {{item.typeText}}</view>
      </view>
    </view>

    <view class="nomore" wx:if="{{noMore && list.length>0}}"><text>没有更多了~</text></view>
  </block>
</view>
