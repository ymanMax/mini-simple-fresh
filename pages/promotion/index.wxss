.promo-page { padding-bottom: 40rpx; }

.tabs { display: flex; background: #fff; position: sticky; top: 0; z-index: 20; border-bottom: 1rpx solid #f2f2f2; }
.tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 27rpx; color: #555; position: relative; }
.tab.on { color: #e93b3d; font-weight: bold; }
.tab.on::after {
  content: ''; position: absolute; bottom: 0; left: 50%;
  transform: translateX(-50%);
  width: 48rpx; height: 6rpx; background: #e93b3d; border-radius: 3rpx;
}

.session-bar { display: flex; gap: 12rpx; padding: 20rpx; }
.sess {
  flex: 1;
  text-align: center;
  background: #f0f1f3;
  border-radius: 12rpx;
  padding: 16rpx 0;
}
.sess.on { background: #fdecec; outline: 2rpx solid #e93b3d; }
.sess.ended { opacity: 0.5; }
.sess-name { font-size: 28rpx; font-weight: bold; }
.sess-status { font-size: 20rpx; color: #838383; margin-top: 4rpx; }
.sess.on .sess-status { color: #e93b3d; }

.countdown-banner {
  margin: 0 24rpx 16rpx;
  background: linear-gradient(135deg, #e93b3d, #ff8a80);
  color: #fff;
  border-radius: 16rpx;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.cd-left { font-size: 26rpx; }
.cd-time { font-size: 40rpx; font-weight: bold; letter-spacing: 2rpx; font-family: monospace; }

.block-title { font-size: 30rpx; font-weight: bold; margin-bottom: 12rpx; }

.seckill-item { display: flex; gap: 16rpx; position: relative; align-items: center; }
.seckill-item > image { width: 140rpx; height: 140rpx; border-radius: 12rpx; background: #f0f0f0; flex-shrink: 0; }
.sess-badge {
  position: absolute; top: 16rpx; left: 16rpx;
  background: #e93b3d; color: #fff;
  font-size: 18rpx; padding: 2rpx 12rpx; border-radius: 8rpx; z-index: 2;
}
.sk-info { flex: 1; }
.sk-name { font-size: 28rpx; font-weight: 600; line-height: 1.4; }
.sk-price-row { display: flex; align-items: baseline; gap: 10rpx; margin: 6rpx 0; }
.sk-price { color: #e93b3d; font-size: 34rpx; font-weight: bold; }
.progress { height: 12rpx; background: #f0f0f0; border-radius: 999rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #e93b3d, #ff8a80); border-radius: 999rpx; }
.progress-text { font-size: 20rpx; color: #838383; margin-top: 4rpx; }
.sk-btn {
  background: #e93b3d; color: #fff;
  padding: 10rpx 24rpx; border-radius: 999rpx; font-size: 24rpx; flex-shrink: 0;
}
.sk-btn.ended { background: #ddd; }

/* 满减 */
.fr-tier {
  display: flex; align-items: center; justify-content: space-between;
  background: #f7f8fa; border-radius: 12rpx; padding: 20rpx; margin-bottom: 12rpx;
}
.fr-title { font-size: 30rpx; font-weight: bold; color: #e93b3d; }
.fr-desc { font-size: 24rpx; color: #838383; margin-top: 4rpx; }
.fr-tag { font-size: 22rpx; background: #fdecec; color: #e93b3d; padding: 6rpx 16rpx; border-radius: 999rpx; }
.full-item { display: flex; gap: 16rpx; align-items: center; }
.full-item > image { width: 130rpx; height: 130rpx; border-radius: 12rpx; background: #f0f0f0; }
.fr-info { flex: 1; }
.fr-name { font-size: 28rpx; font-weight: 600; line-height: 1.4; }
.fr-sub { font-size: 22rpx; color: #838383; margin-top: 4rpx; }
.fr-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.add-btn {
  width: 48rpx; height: 48rpx; line-height: 44rpx; text-align: center;
  background: #e93b3d; color: #fff; border-radius: 50%; font-size: 32rpx; font-weight: bold;
}

/* 领券 */
.coupon-card { display: flex; background: #fff; margin: 16rpx 24rpx; border-radius: 16rpx; overflow: hidden; }
.cc-left { width: 200rpx; background: linear-gradient(135deg, #e93b3d, #ff6b6b); color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 32rpx 0; }
.cc-left.claimed { background: #ccc; }
.cc-amount { font-size: 44rpx; font-weight: bold; }
.cc-rule { font-size: 20rpx; margin-top: 4rpx; opacity: 0.95; }
.cc-mid { flex: 1; padding: 24rpx; }
.cc-name { font-size: 30rpx; font-weight: bold; }
.cc-scope { font-size: 22rpx; color: #838383; margin-top: 8rpx; }
.cc-expire { font-size: 20rpx; color: #b0b0b0; margin-top: 8rpx; }
.cc-btn { align-self: center; margin-right: 24rpx; padding: 12rpx 28rpx; background: #e93b3d; color: #fff; border-radius: 999rpx; font-size: 24rpx; }
.cc-btn.claimed { background: #ddd; }
.more-coupon { text-align: center; color: #e93b3d; font-size: 26rpx; padding: 24rpx; }
