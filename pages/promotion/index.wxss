/* 促销活动页样式 */
.promo-page { padding-bottom: 40rpx; }
.top-tabs { display: flex; background: #fff; position: sticky; top: 0; z-index: 10; box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.04); }
.top-tab { flex: 1; text-align: center; padding: 18rpx 0; font-size: 28rpx; color: #666; border-bottom: 4rpx solid transparent; }
.top-tab.active { color: #e4393c; font-weight: 700; border-bottom-color: #e4393c; }

.session-bar { display: flex; gap: 12rpx; padding: 16rpx; }
.session { flex: 1; text-align: center; padding: 14rpx 0; background: #f2f3f5; border-radius: 12rpx; }
.session.active { background: #fff1f0; border: 1rpx solid #e4393c; }
.session.ended { opacity: .5; }
.session-name { font-size: 24rpx; font-weight: 600; }
.session-status { font-size: 18rpx; color: #999; margin-top: 4rpx; }

.countdown-card { text-align: center; padding: 20rpx; }
.countdown-label { font-size: 24rpx; color: #999; }
.countdown-time { font-size: 48rpx; font-weight: 800; color: #e4393c; letter-spacing: 4rpx; font-family: monospace; }

.seckill-good { display: flex; align-items: center; padding: 16rpx; }
.seckill-img { width: 120rpx; height: 120rpx; border-radius: 12rpx; margin-right: 16rpx; background: #f2f3f5; }
.seckill-price { font-size: 34rpx; }
.progress-bar { width: 100%; height: 12rpx; background: #f2f3f5; border-radius: 999rpx; margin: 8rpx 0; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #e4393c, #ff7875); border-radius: 999rpx; }
.seckill-btn { background: #e4393c; color: #fff; padding: 14rpx 28rpx; border-radius: 999rpx; font-size: 24rpx; white-space: nowrap; }

.tier-card { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 24rpx; }
.tier-threshold { font-size: 30rpx; font-weight: 700; }
.tier-reduce { font-size: 34rpx; font-weight: 800; color: #e4393c; }

.coupon-card { display: flex; align-items: center; background: #fff; border-radius: 16rpx; margin: 16rpx 24rpx; padding: 24rpx; }
.coupon-left { width: 160rpx; text-align: center; border-right: 2rpx dashed #eee; padding-right: 16rpx; }
.coupon-amount { font-size: 36rpx; font-weight: 800; color: #e4393c; }
.coupon-name { font-size: 20rpx; color: #666; margin-top: 4rpx; }
.coupon-right { flex: 1; padding-left: 16rpx; }
.coupon-action { background: #e4393c; color: #fff; padding: 12rpx 24rpx; border-radius: 999rpx; font-size: 22rpx; }

.goods-card { display: flex; background: #fff; padding: 16rpx; border-radius: 12rpx; margin-bottom: 12rpx; }
.goods-img { width: 100rpx; height: 100rpx; border-radius: 8rpx; margin-right: 12rpx; background: #f2f3f5; }
.goods-info { flex: 1; }
.goods-name { font-size: 28rpx; font-weight: 600; }
.goods-sub { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.mini-add { width: 40rpx; height: 40rpx; border-radius: 50%; background: #e4393c; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.section-title-sm { font-size: 30rpx; font-weight: 700; margin-bottom: 12rpx; }
