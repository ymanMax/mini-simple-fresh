.promo-page { min-height: 100vh; padding-bottom: 40rpx; }
.main-tabs { display: flex; background: #fff; position: sticky; top: 0; z-index: 10; }
.main-tab { flex: 1; text-align: center; padding: 18rpx 0; font-size: 26rpx; color: #666; }
.main-tab.on { color: #ff3b30; font-weight: 700; border-bottom: 4rpx solid #ff3b30; }

.session-bar { display: flex; background: #fff; margin: 16rpx 24rpx; border-radius: 16rpx; padding: 8rpx; }
.session { flex: 1; text-align: center; padding: 12rpx 0; border-radius: 12rpx; }
.session.on { background: #fff1f0; }
.session-name { font-size: 26rpx; font-weight: 700; }
.session.on .session-name { color: #ff3b30; }
.session-state { font-size: 18rpx; color: #999; }

.countdown-card { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin: 16rpx 24rpx; background: linear-gradient(135deg,#ff5b4f,#ff3b30); color: #fff; border-radius: 16rpx; padding: 18rpx; }
.cd-title { font-size: 26rpx; }
.cd-box { font-size: 30rpx; font-weight: 700; }
.cd-num { background: rgba(255,255,255,.25); border-radius: 6rpx; padding: 2rpx 10rpx; margin: 0 2rpx; }

.seckill-goods { display: flex; align-items: center; padding: 16rpx; }
.sg-pic { width: 120rpx; height: 120rpx; margin-right: 14rpx; }
.sg-info { flex: 1; }
.sg-name { font-size: 26rpx; font-weight: 600; }
.sg-prices { display: flex; align-items: baseline; gap: 10rpx; margin: 4rpx 0; }
.seckill-price { font-size: 32rpx; font-weight: 700; color: #ff3b30; }
.sg-bar { height: 10rpx; background: #ffe3e0; border-radius: 5rpx; overflow: hidden; width: 80%; }
.sg-bar-fill { height: 100%; background: #ff3b30; border-radius: 5rpx; }
.sg-cta { background: #ff3b30; color: #fff; font-size: 24rpx; padding: 10rpx 22rpx; border-radius: 32rpx; }

.ladder { padding: 20rpx 24rpx; }
.ladder-title { font-size: 26rpx; font-weight: 700; margin-bottom: 12rpx; }
.ladder-row { display: flex; align-items: center; padding: 12rpx 0; border-bottom: 1rpx dashed #eee; }
.ladder-left { flex: 1; font-size: 26rpx; font-weight: 600; }
.ladder-arrow { color: #999; margin: 0 12rpx; }
.ladder-reduce { font-size: 30rpx; font-weight: 700; color: #ff3b30; }
.section-title { font-size: 28rpx; font-weight: 700; margin: 16rpx 28rpx 8rpx; }

.goods-card { margin: 12rpx 24rpx; }
.goods-card .pic { width: 120rpx; height: 120rpx; }

.coupon-card { display: flex; align-items: center; background: #fff; border-radius: 14rpx; margin: 14rpx 24rpx; overflow: hidden; }
.cc-left { width: 170rpx; text-align: center; background: linear-gradient(135deg,#ff6b6b,#ff3b30); color: #fff; padding: 22rpx 0; border-radius: 14rpx 0 0 14rpx; }
.cc-amount { font-size: 32rpx; font-weight: 700; }
.cc-right { flex: 1; padding: 14rpx; }
.cc-name { font-size: 26rpx; font-weight: 600; }
.cc-claim { background: #fff1f0; color: #ff3b30; font-size: 22rpx; padding: 8rpx 20rpx; border-radius: 28rpx; margin-right: 16rpx; border: 1rpx solid #ff3b30; white-space: nowrap; }
