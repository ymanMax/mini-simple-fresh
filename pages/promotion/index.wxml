<view class="promo-page">
  <!-- Tabs -->
  <view class="tabs">
    <view class="tab {{activeTab === item.key ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="switchTab">{{item.name}}</view>
  </view>

  <!-- ============ 限时抢购 ============ -->
  <block wx:if="{{activeTab === 'seckill'}}">
    <!-- 场次条 -->
    <view class="session-bar card">
      <view class="sess {{activeSession.sessionId === item.sessionId ? 'on' : ''}} {{item.status === 3 ? 'ended' : ''}}"
        wx:for="{{sessions}}" wx:key="sessionId"
        data-id="{{item.sessionId}}" bindtap="pickSession">
        <view class="sess-name">{{item.name}}</view>
        <view class="sess-status">{{item.status === 2 ? '抢购中' : (item.status === 1 ? '未开始' : '已结束')}}</view>
      </view>
    </view>

    <!-- 倒计时横幅 -->
    <view class="countdown-banner">
      <view class="cd-left">{{countdownLabel}}（{{activeSession.name}}）</view>
      <view class="cd-time">{{countdown}}</view>
    </view>

    <!-- 抢购商品（按场次分组展示）-->
    <block wx:for="{{seckillList}}" wx:key="goodsId">
      <view class="card seckill-item">
        <view class="sess-badge">{{item.sessionName}}</view>
        <image src="{{item.pic}}" mode="aspectFill" data-id="{{item.id}}" bindtap="goDetail"></image>
        <view class="sk-info">
          <view class="sk-name" data-id="{{item.id}}" bindtap="goDetail">{{item.name}}</view>
          <view class="sk-price-row">
            <text class="sk-price">￥{{item.seckillPriceYuan}}</text>
            <text class="price-origin">￥{{item.minPriceYuan}}</text>
          </view>
          <view class="progress">
            <view class="progress-fill" style="width: {{item.soldPercent}}%;"></view>
          </view>
          <view class="progress-text">已抢 {{item.soldPercent}}% · 剩余 {{item.seckillStock}} 件</view>
        </view>
        <view class="sk-btn {{item.sessionStatus === 3 ? 'ended' : ''}}" data-gid="{{item.goodsId}}" bindtap="seckillBuy">
          {{item.sessionStatus === 3 ? '已结束' : '马上抢'}}
        </view>
      </view>
    </block>
    <view class="empty-page" wx:if="{{!loading && !seckillList.length}}">
      <image src="/images/empty-order.jpg"></image>
      <view class="empty-title">该场次暂无抢购商品</view>
    </view>
  </block>

  <!-- ============ 满减专区 ============ -->
  <block wx:if="{{activeTab === 'fullReduce'}}">
    <view class="card">
      <view class="block-title">满减阶梯（自动减免，可与优惠券叠加）</view>
      <view class="fr-tier" wx:for="{{fullReduceRules}}" wx:key="threshold">
        <view class="fr-left">
          <view class="fr-title">{{item.title}}</view>
          <view class="fr-desc">满 {{item.thresholdYuan}} 元立减 {{item.reduceYuan}} 元</view>
        </view>
        <view class="fr-tag">阶梯优惠</view>
      </view>
    </view>
    <view class="block-title" style="padding:16rpx 32rpx 4rpx;">参与满减的热门商品</view>
    <view class="card full-item" wx:for="{{fullReduceGoods}}" wx:key="id">
      <image src="{{item.pic}}" mode="aspectFill" data-id="{{item.id}}" bindtap="goDetail"></image>
      <view class="fr-info">
        <view class="fr-name" data-id="{{item.id}}" bindtap="goDetail">{{item.name}}</view>
        <view class="fr-sub">{{item.subtitle}}</view>
        <view class="fr-bottom">
          <view class="price">￥{{item.minPriceYuan}}</view>
          <view class="add-btn" data-id="{{item.id}}" bindtap="addCart">＋</view>
        </view>
      </view>
    </view>
  </block>

  <!-- ============ 领券中心 ============ -->
  <block wx:if="{{activeTab === 'coupon'}}">
    <view class="coupon-card" wx:for="{{couponList}}" wx:key="id">
      <view class="cc-left {{item.claimed ? 'claimed' : ''}}">
        <view class="cc-amount">{{item.amountLabel}}</view>
        <view class="cc-rule">{{item.ruleLabel}}</view>
      </view>
      <view class="cc-mid">
        <view class="cc-name">{{item.name}}</view>
        <view class="cc-scope">{{item.scope}} · {{item.source}}</view>
        <view class="cc-expire">有效期 {{item.expireDays}} 天 · 剩余 {{item.left}}/{{item.total}} 张</view>
      </view>
      <view class="cc-btn {{item.claimed ? 'claimed' : ''}}" data-id="{{item.id}}" bindtap="claim">
        {{item.claimed ? '已领取' : '立即领取'}}
      </view>
    </view>
    <view class="more-coupon" bindtap="goCouponPage">查看全部优惠券 ›</view>
  </block>

  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk-block" style="height:200rpx;"></view>
    <view class="sk-row"><view class="sk-line w80"></view></view>
  </view>
</view>
