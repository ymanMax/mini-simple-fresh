<!-- 促销活动：限时抢购（场次+倒计时+进度条）/ 满减专区 / 领券中心。全部使用预计算字段，无表达式比较/三元/多插值 -->
<view class="page-wrap promo-page">
  <!-- 顶部Tab（cls 预计算） -->
  <view class="top-tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="{{item.cls}}" bindtap="switchTab" data-tab="{{item.key}}">{{item.name}}</view>
  </view>

  <view wx:if="{{loading}}" class="skeleton">
    <view class="sk-block" style="height:160rpx"></view>
    <view class="sk-block" style="height:180rpx"></view>
    <view class="sk-block" style="height:180rpx"></view>
  </view>

  <!-- 限时抢购（tabActive 预计算布尔） -->
  <block wx:if="{{seckillTabActive}}">
    <!-- 场次条：cls 预计算 active/ended -->
    <view class="card session-bar">
      <view wx:for="{{sessions}}" wx:key="sessionId" class="{{item.cls}}" bindtap="pickSession" data-id="{{item.sessionId}}">
        <view class="session-name">{{item.name}}</view>
        <view class="session-status">{{item.statusText}}</view>
      </view>
    </view>

    <!-- 倒计时 -->
    <view class="card countdown-card">
      <view class="countdown-label">{{countdownLabel}}</view>
      <view class="countdown-time">{{countdown}}</view>
    </view>

    <!-- 抢购商品：抢购价/原价划线/进度条/剩余库存 -->
    <view class="card seckill-good" wx:for="{{seckillGoods}}" wx:key="goodsId">
      <image class="seckill-img" src="{{item.pic}}" mode="aspectFill" binderror="onImgError" data-key="seckillGoods[{{index}}].pic"></image>
      <view class="flex-1">
        <view class="goods-name">{{item.name}}</view>
        <view class="row-between">
          <view class="price-sm seckill-price">¥{{item.seckillPrice/100}}</view>
          <view class="price-origin">¥{{item.originalPrice/100}}</view>
        </view>
        <!-- 已抢进度条（纯CSS，width 预计算百分比） -->
        <view class="progress-bar">
          <view class="progress-fill" style="width:{{item.soldPercent}}%"></view>
        </view>
        <view class="muted small">已抢{{item.soldPercent}}% · 剩余{{item.stock}}份</view>
      </view>
      <view class="seckill-btn" bindtap="seckillBuy" data-id="{{item.goodsId}}">马上抢</view>
    </view>
  </block>

  <!-- 满减专区 -->
  <block wx:elif="{{fullreduceTabActive}}">
    <view class="card tier-card" wx:for="{{fullReduceRules}}" wx:key="threshold">
      <view class="tier-threshold">满{{item.threshold/100}}元</view>
      <view class="tier-reduce">减{{item.reduce/100}}元</view>
    </view>
    <view class="card">
      <view class="section-title-sm">参与商品</view>
      <view class="goods-card" wx:for="{{fullReduceGoods}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <image class="goods-img" src="{{item.pic}}" mode="aspectFill" binderror="onImgError" data-key="fullReduceGoods[{{index}}].pic"></image>
        <view class="goods-info">
          <view class="goods-name">{{item.name}}</view>
          <view class="goods-sub">{{item.subtitle}} · {{item.origin}}</view>
          <view class="row-between">
            <view class="price-sm">¥{{item.price/100}}<text class="price-origin">¥{{item.originalPrice/100}}</text></view>
            <view class="mini-add" catchtap="addCart" data-id="{{item.id}}">+</view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 领券中心（else） -->
  <block wx:else>
    <view wx:if="{{couponEmpty}}" class="empty">
      <image class="empty-img" src="/images/default.png" binderror="onImgError" data-key="emptyImg"></image>
      <view class="empty-title">暂无优惠券</view>
    </view>
    <view class="coupon-card" wx:for="{{couponCenter}}" wx:key="id">
      <view class="coupon-left">
        <view class="coupon-amount">{{item.amountText}}</view>
        <view class="coupon-name">{{item.name}}</view>
      </view>
      <view class="coupon-right">
        <view class="muted small">{{item.scope}} · 满{{item.threshold/100}}可用</view>
        <view class="muted small">有效期至 {{item.expireTime}}</view>
        <view class="muted small">剩余 {{item.remain}} 张 / 共 {{item.total}} 张</view>
      </view>
      <view class="coupon-action" bindtap="claim" data-id="{{item.id}}">立即领取</view>
    </view>
  </block>
</view>
