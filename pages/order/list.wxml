<view class="order-page">
  <!-- 状态 Tab -->
  <view class="tabs">
    <view
      class="tab {{activeTab === item.key ? 'on' : ''}}"
      wx:for="{{tabs}}" wx:key="key"
      data-key="{{item.key}}" bindtap="switchTab">
      {{item.name}}
      <view class="tab-badge" wx:if="{{counts[item.key] > 0}}">{{counts[item.key]}}</view>
    </view>
  </view>

  <!-- 骨架 -->
  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk-row"><view class="sk-block sk-img"></view><view class="flex1"><view class="sk-line w80"></view><view class="sk-line w60"></view></view></view>
    <view class="sk-row"><view class="sk-block sk-img"></view><view class="flex1"><view class="sk-line w80"></view><view class="sk-line w60"></view></view></view>
  </view>

  <!-- 订单列表 -->
  <block wx:if="{{!loading}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="oc-head">
        <text class="oc-no">订单号：{{item.orderNo}}</text>
        <text class="oc-status s{{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="oc-items">
        <view class="oc-thumb-row">
          <image class="oc-thumb" wx:for="{{item.preview}}" wx:for-item="it" wx:key="goodsId" src="{{it.pic}}" mode="aspectFill"></image>
          <view class="oc-count" wx:if="{{item.moreCount > 0}}">+{{item.moreCount}}</view>
        </view>
        <view class="oc-first-name">{{item.items[0].name}}<text wx:if="{{item.items.length > 1}}"> 等{{item.items.length}}件商品</text></view>
      </view>
      <view class="oc-foot">
        <view class="oc-amount">实付 <text class="price price-big">￥{{item.payAmountYuan}}</text></view>
        <view class="oc-time">{{item.createTimeText}}</view>
      </view>
      <view class="oc-actions">
        <view class="oc-btn plain" wx:if="{{item.status === 1}}" data-id="{{item.id}}" catchtap="cancel">取消订单</view>
        <view class="oc-btn plain" wx:if="{{item.status === 6}}" data-id="{{item.id}}" catchtap="rebuy">再来一单</view>
        <view class="oc-btn primary" wx:if="{{item.status === 1}}" data-id="{{item.id}}" catchtap="pay">去支付</view>
        <view class="oc-btn plain" wx:if="{{item.status === 4}}" data-id="{{item.id}}" catchtap="confirmReceive">确认收货</view>
        <view class="oc-btn plain" wx:if="{{item.status === 5 && !item.isReviewed}}" data-id="{{item.id}}" catchtap="goReview">去评价</view>
        <view class="oc-btn plain" wx:if="{{item.status === 5}}" data-id="{{item.id}}" catchtap="rebuy">再来一单</view>
        <view class="oc-btn neutral" data-id="{{item.id}}" catchtap="goDetail">查看详情</view>
      </view>
    </view>

    <!-- 空态 -->
    <view class="empty-page" wx:if="{{!orders.length}}">
      <image src="/images/empty-order.jpg"></image>
      <view class="empty-title">暂无相关订单</view>
      <view class="empty-desc">去挑选新鲜好物吧</view>
      <view class="empty-btn" bindtap="goShop">去逛逛</view>
    </view>

    <view class="list-end" wx:if="{{!hasMore && orders.length}}">—— 没有更多了 ~ ——</view>
    <view class="list-end" wx:if="{{hasMore && orders.length}}">上拉加载更多</view>
  </block>
</view>
