/* 订单详情样式 */
.detail-page { padding-bottom: 160rpx; }

.status-header { padding: 40rpx 24rpx; border-radius: 0 0 24rpx 24rpx; color: #fff; }
.status-bg-1 { background: linear-gradient(135deg, #fa8c16, #ff9c6e); }
.status-bg-2 { background: linear-gradient(135deg, #1890ff, #69c0ff); }
.status-bg-3 { background: linear-gradient(135deg, #52c41a, #95de64); }
.status-bg-4 { background: linear-gradient(135deg, #e4393c, #ff7875); }
.status-bg-5 { background: linear-gradient(135deg, #595959, #8c8c8c); }
.status-bg-6 { background: linear-gradient(135deg, #8c8c8c, #bfbfbf); }
.status-title { font-size: 36rpx; font-weight: 800; }
.status-sub { font-size: 24rpx; opacity: .9; margin-top: 8rpx; }

.tl-item { display: flex; padding: 12rpx 0; position: relative; }
.tl-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #ddd; margin: 6rpx 16rpx 0 4rpx; flex-shrink: 0; }
.tl-dot.active { background: #e4393c; box-shadow: 0 0 0 6rpx #fff1f0; }
.tl-status { font-size: 28rpx; font-weight: 600; }

.info-row { display: flex; padding: 10rpx 0; font-size: 26rpx; }
.info-label { width: 120rpx; color: #999; }

.order-item { display: flex; align-items: center; padding: 10rpx 0; }
.order-img { width: 90rpx; height: 90rpx; border-radius: 8rpx; margin-right: 12rpx; background: #f2f3f5; }
.order-name { font-size: 26rpx; }

.amount-row { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 26rpx; }
.amount-row.total { font-size: 30rpx; font-weight: 700; }

.bottom-actions {
  position: fixed; left: 0; right: 0; bottom: 0; padding: 16rpx 24rpx; background: #fff;
  display: flex; justify-content: flex-end; gap: 16rpx; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06); z-index: 100;
}
.action-btn { padding: 14rpx 36rpx; border-radius: 999rpx; font-size: 28rpx; }
.action-btn.primary { background: #e4393c; color: #fff; }
.action-btn.plain { background: #fff; color: #e4393c; border: 1rpx solid #e4393c; }

/* 骑手卡片 */
.rider-card { display: flex; align-items: center; }
.rider-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; margin-right: 16rpx; background: #f2f3f5; }
.rider-name { font-size: 28rpx; font-weight: 700; }
.rider-call { background: #e4393c; color: #fff; padding: 10rpx 24rpx; border-radius: 999rpx; font-size: 22rpx; white-space: nowrap; }

/* 售后退款 */
.refund-card { border-left: 6rpx solid #52c41a; }

/* 订单号复制 */
.copy-link { color: #e4393c; font-size: 24rpx; }

/* timeline 节点 */
.tl-item.done .tl-status { font-weight: 600; }
.done-dot { background: #52c41a !important; box-shadow: 0 0 0 6rpx #f6ffed; }
