/* 订单评价样式 */
.review-goods-img { width: 90rpx; height: 90rpx; border-radius: 12rpx; margin-right: 16rpx; background: #f2f3f5; }
.order-name { font-size: 28rpx; font-weight: 600; }

.score-row { display: flex; align-items: center; padding: 14rpx 0; }
.score-label { width: 120rpx; font-size: 26rpx; color: #666; }
.stars { display: flex; gap: 4rpx; }
.star { font-size: 36rpx; color: #ddd; }
.star.on { color: #ffa500; }

.tag-row { display: flex; flex-wrap: wrap; gap: 10rpx; padding: 8rpx 0; }
.tag-selected { background: #fff1f0 !important; color: #e4393c !important; border: 1rpx solid #e4393c; }

.review-input {
  background: #f7f8fa; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 26rpx; margin: 10rpx 0;
}
.upload-row { display: flex; gap: 12rpx; padding: 10rpx 0; flex-wrap: wrap; }
.upload-box {
  width: 100rpx; height: 100rpx; border: 2rpx dashed #ccc; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center; color: #999; font-size: 24rpx;
}
.upload-img { width: 100rpx; height: 100rpx; border-radius: 12rpx; }

.submit-wrap { padding: 30rpx 24rpx 60rpx; }
.submit-btn { height: 80rpx; line-height: 80rpx; font-size: 30rpx; }
