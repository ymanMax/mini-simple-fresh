<!-- 商品分类页：左侧分类导航（数量统计）+ 分类内搜索 + 吸顶排序栏 + 自定义筛选抽屉 + 客户端分页商品列表 + 推荐 + 加购 -->
<view class="category-page">
  <!-- 1. 顶部搜索框（占位"搜索当前分类商品"，清空图标 + 取消） -->
  <view class="search-bar">
    <image class="search-icon" src="/images/icons/search.png" binderror="onImgError" data-key="searchIcon"></image>
    <input class="search-input" placeholder="搜索当前分类商品" value="{{keyword}}" bindinput="onInput" confirm-type="search" />
    <view class="search-clear" wx:if="{{keyword}}" bindtap="clearKeyword">×</view>
    <view class="search-cancel" bindtap="cancelSearch">取消</view>
  </view>

  <view class="main">
    <!-- 左侧分类导航（商品数量统计，选中主题色高亮） -->
    <view class="side-nav">
      <view class="nav-item {{currentCategory==item.id?'active':''}}" wx:for="{{categories}}" wx:key="id" bindtap="switchCategory" data-id="{{item.id}}" data-name="{{item.name}}">
        <view>{{item.name}}</view>
        <view class="nav-count">{{item.count}}</view>
      </view>
    </view>

    <!-- 右侧内容区 -->
    <view class="content-area">
      <!-- 2. 吸顶排序栏：综合 / 价格(升降切换+箭头) / 销量 / 筛选按钮 -->
      <view class="sort-bar">
        <view class="sort-item {{sort=='default'?'active':''}}" bindtap="chooseSort" data-sort="default">综合</view>
        <view class="sort-item {{sort=='priceAsc'||sort=='priceDesc'?'active':''}}" bindtap="chooseSort" data-sort="price">
          价格<text class="sort-arrow">{{sortArrow}}</text>
        </view>
        <view class="sort-item {{sort=='sales'?'active':''}}" bindtap="chooseSort" data-sort="sales">销量</view>
        <view class="filter-btn {{filterCount>0?'active':''}}" bindtap="openFilter">
          筛选<text wx:if="{{filterCount>0}}" class="filter-dot">{{filterCount}}</text>
        </view>
      </view>

      <!-- 骨架屏 -->
      <view wx:if="{{loading}}" class="skeleton">
        <view class="sk-block" style="height:140rpx"></view>
        <view class="sk-block" style="height:140rpx"></view>
        <view class="sk-block" style="height:140rpx"></view>
      </view>

      <!-- 空态：搜索无结果 / 筛选无结果（插图 + 文案） -->
      <view wx:elif="{{products.length==0}}" class="empty">
        <image class="empty-img" src="/images/default.png" binderror="onImgError" data-key="emptyImg"></image>
        <view class="empty-title">未找到相关商品</view>
        <view class="empty-sub">换个关键词或调整筛选条件试试</view>
        <view class="btn-primary go-shop-btn" bindtap="resetFilters" wx:if="{{filterCount>0 || keyword}}">重置筛选</view>
      </view>

      <block wx:else>
        <!-- 推荐商品：当前分类销量前3，横向滑动 -->
        <view class="recommend-card" wx:if="{{recommend.length>0 && page==1 && !keyword && filterCount==0}}">
          <view class="section-title-sm">{{currentName}}推荐</view>
          <scroll-view scroll-x class="h-scroll" style="padding:0">
            <view class="h-scroll-item reco-item" wx:for="{{recommend}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
              <image class="reco-img" src="{{item.pic}}" mode="aspectFill" binderror="onImgError" data-key="recommend[{{index}}].pic"></image>
              <view class="reco-name">{{item.name}}</view>
              <view class="price-sm">¥{{item.price/100}}</view>
            </view>
          </scroll-view>
        </view>

        <!-- 商品列表（客户端分页，每页10条） -->
        <view class="goods-card" wx:for="{{products}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
          <image class="goods-img" src="{{item.pic}}" mode="aspectFill" binderror="onImgError" data-key="products[{{index}}].pic"></image>
          <view class="goods-info">
            <view class="goods-name">{{item.name}}</view>
            <view class="goods-sub">{{item.subtitle}} · {{item.origin}}</view>
            <view class="tag-row">
              <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
            </view>
            <view class="row-between">
              <view class="price-sm">¥{{item.price/100}}<text class="price-origin">¥{{item.originalPrice/100}}</text></view>
              <view class="add-btn" catchtap="addCart" data-id="{{item.id}}">+</view>
            </view>
          </view>
        </view>

        <!-- 上拉/点击加载更多（每页10条，加载完显示"没有更多了"） -->
        <view class="load-more" wx:if="{{!noMore && products.length>0}}" bindtap="loadMore">
          <text>加载更多（已显示 {{products.length}} / {{total}} 件）</text>
        </view>
        <view class="nomore" wx:if="{{noMore && products.length>0}}"><text>没有更多了~（共 {{total}} 件）</text></view>
      </block>
    </view>
  </view>

  <!-- 3. 自定义筛选抽屉：价格区间 / 仅看有货 / 优惠类型 / 商品标签 / 重置+确定（结果数） -->
  <view class="filter-mask" wx:if="{{filterOpen}}" bindtap="closeFilter">
    <view class="filter-panel" catchtap="">
      <view class="panel-title">
        <text>筛选</text>
        <view class="panel-close" bindtap="closeFilter">×</view>
      </view>

      <!-- 价格区间（单位元，内部转分；支持单边填写） -->
      <view class="filter-group">
        <view class="filter-label">价格区间（元）</view>
        <view class="price-row">
          <input class="price-input" type="digit" placeholder="最低价" value="{{priceMin}}" bindinput="onPriceMinInput" />
          <text class="price-sep">—</text>
          <input class="price-input" type="digit" placeholder="最高价" value="{{priceMax}}" bindinput="onPriceMaxInput" />
        </view>
      </view>

      <!-- 仅看有货 -->
      <view class="filter-group">
        <view class="filter-label">仅看有货</view>
        <view class="switch {{inStockOnly?'on':''}}" bindtap="toggleInStock"></view>
      </view>

      <!-- 优惠类型：多选胶囊（会员价 / 促销直降） -->
      <view class="filter-group">
        <view class="filter-label">优惠类型</view>
        <view class="capsule-row">
          <view class="capsule {{item.selected?'selected':''}}" wx:for="{{discountList}}" wx:key="name" bindtap="toggleDiscount" data-tag="{{item.name}}">{{item.name}}</view>
        </view>
      </view>

      <!-- 商品标签：多选胶囊（按 product_tags 匹配） -->
      <view class="filter-group">
        <view class="filter-label">商品标签</view>
        <view class="capsule-row">
          <view class="capsule {{item.selected?'selected':''}}" wx:for="{{tagList}}" wx:key="name" bindtap="toggleProductTag" data-tag="{{item.name}}">{{item.name}}</view>
        </view>
      </view>

      <!-- 底部：重置 + 确定（应用并展示结果数） -->
      <view class="panel-actions">
        <view class="panel-reset" bindtap="resetFilters">重置</view>
        <view class="panel-confirm" bindtap="applyFilterPanel">确定（共 {{resultCount}} 件）</view>
      </view>
    </view>
  </view>
</view>
