.msg-page { padding-bottom: 40rpx; }
.tabs { display: flex; align-items: center; background: #fff; border-bottom: 1rpx solid #f2f2f2; position: sticky; top: 0; z-index: 20; }
.tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 27rpx; color: #555; position: relative; }
.tab.on { color: #e93b3d; font-weight: bold; }
.tab.on::after {
  content: ''; position: absolute; bottom: 0; left: 50%;
  transform: translateX(-50%);
  width: 48rpx; height: 6rpx; background: #e93b3d; border-radius: 3rpx;
}
.read-all { padding: 0 24rpx; font-size: 24rpx; color: #e93b3d; }

.msg-item { display: flex; gap: 16rpx; position: relative; }
.msg-item.unread { border-left: 6rpx solid #e93b3d; }
.msg-icon {
  width: 72rpx; height: 72rpx;
  border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 30rpx; flex-shrink: 0;
}
.msg-icon.t1 { background: #03a9f4; }
.msg-icon.t2 { background: #e93b3d; }
.msg-icon.t3 { background: #ff9500; }
.msg-icon.t4 { background: #43a047; }
.msg-info { flex: 1; }
.msg-head { display: flex; align-items: center; justify-content: space-between; }
.msg-title { font-size: 28rpx; font-weight: 600; }
.msg-dot { width: 14rpx; height: 14rpx; background: #e93b3d; border-radius: 50%; }
.msg-content { font-size: 25rpx; color: #555; margin-top: 6rpx; line-height: 1.5; }
.msg-time { font-size: 20rpx; color: #b0b0b0; margin-top: 8rpx; }
