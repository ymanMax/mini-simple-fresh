<view class="msg-page">
  <!-- 类型 Tab -->
  <view class="tabs">
    <view class="tab {{filter === item.key ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="key" bindtap="switchFilter" data-filter="{{item.key}}">{{item.name}}</view>
  </view>

  <view class="msg-toolbar">
    <text class="muted" bindtap="readAll">全部已读</text>
  </view>

  <view class="msg-card card {{item.isRead ? '' : 'unread'}}" wx:for="{{messages}}" wx:key="id" bindtap="openMsg" data-id="{{item.id}}">
    <view class="msg-icon">{{item.icon}}</view>
    <view class="msg-body">
      <view class="msg-head">
        <view class="msg-title">{{item.title}}</view>
        <view class="msg-dot" wx:if="{{!item.isRead}}"></view>
      </view>
      <view class="msg-content">{{item.content}}</view>
      <view class="muted msg-time">{{item.relTime}} · {{item.typeName}}</view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !messages.length}}">
    <view class="empty-img">📬</view>
    <view class="empty-text">暂无消息</view>
  </view>

  <view class="nomore" wx:if="{{!hasMore && messages.length}}">— 没有更多了 —</view>
  <view class="loading-more" wx:if="{{loading}}">加载中…</view>

  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk-line" style="width:100%;height:110rpx;margin:16rpx 24rpx"></view>
    <view class="sk-line" style="width:100%;height:110rpx;margin:0 24rpx"></view>
  </view>
</view>
