<view class="msg-page">
  <!-- 类型 Tab -->
  <view class="tabs">
    <view class="tab {{activeTab === item.key ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="switchTab">{{item.name}}</view>
    <view class="read-all" bindtap="readAll">全部已读</view>
  </view>

  <!-- 消息列表 -->
  <view class="card msg-item {{!item.isRead ? 'unread' : ''}}" wx:for="{{list}}" wx:key="id" data-item="{{item}}" bindtap="tapMessage">
    <view class="msg-icon t{{item.type}}">{{item.type === 1 ? '系' : (item.type === 2 ? '单' : (item.type === 3 ? '促' : '评'))}}</view>
    <view class="msg-info">
      <view class="msg-head">
        <text class="msg-title">{{item.title}}</text>
        <view class="msg-dot" wx:if="{{!item.isRead}}"></view>
      </view>
      <view class="msg-content">{{item.content}}</view>
      <view class="msg-time">{{item.timeText}}</view>
    </view>
  </view>

  <view class="empty-page" wx:if="{{!list.length && !loading}}">
    <image src="/images/empty-order.jpg"></image>
    <view class="empty-title">暂无消息</view>
    <view class="empty-desc">订单与促销通知会出现在这里</view>
  </view>

  <view class="list-end" wx:if="{{!hasMore && list.length}}">—— 没有更多了 ~ ——</view>
  <view class="list-end" wx:if="{{hasMore && list.length}}">上拉加载更多</view>

  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk-row"><view class="sk-line w80"></view></view>
    <view class="sk-row"><view class="sk-line w80"></view></view>
  </view>
</view>
