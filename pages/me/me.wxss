.me-page { min-height: 100vh; padding-bottom: 40rpx; }
.me-header { background: linear-gradient(135deg,#ff5b4f,#ff3b30); padding: 40rpx 24rpx; display: flex; align-items: center; color: #fff; }
.avatar-wrap { width: 120rpx; height: 120rpx; }
.avatar { width: 120rpx; height: 120rpx; border: 3rpx solid rgba(255,255,255,.6); }
.user-info { margin-left: 20rpx; flex: 1; }
.nickname { font-size: 34rpx; font-weight: 700; }
.level-badge { display: inline-block; background: rgba(255,255,255,.25); font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 20rpx; margin-top: 6rpx; }
.header-stats { display: flex; gap: 24rpx; }
.stat { text-align: center; }
.stat-num { font-size: 30rpx; font-weight: 700; }
.stat-label { font-size: 20rpx; opacity: .9; }

.member-bar { display: flex; justify-content: space-between; align-items: center; margin-top: -20rpx; position: relative; z-index: 2; }
.member-title { font-size: 28rpx; font-weight: 700; }

.order-card { margin-top: 16rpx; padding: 20rpx; }
.order-head { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.order-title { font-size: 28rpx; font-weight: 700; }
.order-grid { display: flex; justify-content: space-around; }
.og-item { display: flex; flex-direction: column; align-items: center; position: relative; padding: 6rpx 12rpx; }
.og-icon { font-size: 44rpx; }
.og-label { font-size: 22rpx; margin-top: 4rpx; color: #555; }

.menu-group { margin-top: 16rpx; padding: 0 24rpx; }
.menu-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f2f2f2; }
.menu-item:last-child { border-bottom: none; }
.menu-title { font-size: 28rpx; }
.menu-right { display: flex; align-items: center; gap: 8rpx; }
.menu-arrow { color: #ccc; font-size: 30rpx; }

.growth-bar { height: 10rpx; background: #eee; border-radius: 5rpx; margin-top: 8rpx; width: 320rpx; overflow: hidden; }
.growth-fill { height: 100%; background: linear-gradient(90deg,#ff5b4f,#ff3b30); border-radius: 5rpx; }
.menu-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #ff3b30; margin-right: 6rpx; }
