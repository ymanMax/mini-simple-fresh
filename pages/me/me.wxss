/* 个人中心样式 */
.me-page { padding-bottom: 40rpx; }

.user-card {
  background: linear-gradient(135deg, #e4393c, #ff6b6b);
  margin: 0; padding: 40rpx 32rpx; display: flex; align-items: center;
  border-radius: 0 0 24rpx 24rpx; color: #fff;
}
.avatar { width: 96rpx; height: 96rpx; border-radius: 50%; border: 3rpx solid #fff; background: #fff; }
.user-info { margin-left: 20rpx; }
.username { font-size: 34rpx; font-weight: 700; }
.level-badge {
  display: inline-block; margin-top: 8rpx; font-size: 20rpx; background: rgba(255,255,255,0.25);
  padding: 4rpx 16rpx; border-radius: 999rpx;
}
.user-stats { margin-left: auto; display: flex; gap: 32rpx; }
.stat { text-align: center; }
.stat-num { font-size: 32rpx; font-weight: 800; }
.stat-label { font-size: 20rpx; opacity: .9; }

.order-quick { padding: 20rpx 24rpx; }
.quick-row { display: flex; justify-content: space-around; padding: 16rpx 0 4rpx; }
.quick-item { display: flex; flex-direction: column; align-items: center; width: 20%; }
.quick-icon-wrap { position: relative; width: 64rpx; height: 64rpx; }
.quick-icon { width: 56rpx; height: 56rpx; }
.quick-name { font-size: 22rpx; margin-top: 6rpx; color: #555; }

.menu-group { padding: 8rpx 24rpx; }
.group-title { font-size: 24rpx; color: #999; padding: 12rpx 0 4rpx; }
.menu-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.menu-item:last-child { border-bottom: none; }
.menu-icon { width: 44rpx; height: 44rpx; margin-right: 16rpx; }
.menu-name { font-size: 28rpx; }
.menu-arrow { color: #ccc; font-size: 32rpx; }
.red-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #e4393c; margin-right: 12rpx; }

.section-title-sm { font-size: 30rpx; font-weight: 700; }
