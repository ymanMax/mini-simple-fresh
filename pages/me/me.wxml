<view class="me-page">
  <!-- 头部用户卡 -->
  <view class="me-header">
    <view class="avatar-wrap" bindtap="getUserProfile">
      <pic src="{{userInfo.avatarUrl || '/images/avatar.png'}}" mode="aspectFill" radius="50%" class="avatar"/>
    </view>
    <view class="user-info">
      <view class="nickname">{{userInfo.nickName || '鲜生活用户'}}</view>
      <view class="level-badge">{{member.levelName || '银卡会员'}}</view>
    </view>
    <view class="header-stats">
      <view class="stat" bindtap="goMenu" data-url="/pages/member/points">
        <view class="stat-num">{{points}}</view>
        <view class="stat-label">积分</view>
      </view>
      <view class="stat" bindtap="goMenu" data-url="/pages/coupon/index?tab=my">
        <view class="stat-num">{{couponCount}}</view>
        <view class="stat-label">优惠券</view>
      </view>
      <view class="stat">
        <view class="stat-num">{{messageUnread}}</view>
        <view class="stat-label">消息</view>
      </view>
    </view>
  </view>

  <!-- 会员权益条（成长值进度条，纯CSS） -->
  <view class="member-bar card">
    <view class="member-left">
      <view class="member-title">👑 {{member.levelName}}</view>
      <view class="muted">成长值 {{member.growthValue}} / {{member.nextLevelGrowth}}</view>
      <view class="growth-bar"><view class="growth-fill" style="width:{{growthPercent}}%"></view></view>
    </view>
    <view class="member-go" bindtap="goMenu" data-url="/pages/vip/vip">会员中心 ›</view>
  </view>

  <!-- 订单快捷入口 -->
  <view class="card order-card">
    <view class="order-head" bindtap="goAllOrders">
      <view class="order-title">我的订单</view>
      <view class="muted">全部订单 ›</view>
    </view>
    <view class="order-grid">
      <view class="og-item" bindtap="goOrderTab" data-status="1">
        <view class="og-icon">💰</view><view class="og-label">待付款</view>
        <view class="badge" wx:if="{{orderCounts[1]}}">{{orderCounts[1]}}</view>
      </view>
      <view class="og-item" bindtap="goOrderTab" data-status="2">
        <view class="og-icon">📦</view><view class="og-label">待发货</view>
        <view class="badge" wx:if="{{orderCounts[2]}}">{{orderCounts[2]}}</view>
      </view>
      <view class="og-item" bindtap="goOrderTab" data-status="3">
        <view class="og-icon">🛵</view><view class="og-label">配送中</view>
        <view class="badge" wx:if="{{orderCounts[3]}}">{{orderCounts[3]}}</view>
      </view>
      <view class="og-item" bindtap="goOrderTab" data-status="4">
        <view class="og-icon">📬</view><view class="og-label">待收货</view>
        <view class="badge" wx:if="{{orderCounts[4]}}">{{orderCounts[4]}}</view>
      </view>
      <view class="og-item" bindtap="goOrderTab" data-status="5">
        <view class="og-icon">⭐</view><view class="og-label">待评价</view>
        <view class="badge" wx:if="{{orderCounts[5]}}">{{orderCounts[5]}}</view>
      </view>
    </view>
  </view>

  <!-- 菜单分组 -->
  <view class="menu-group card" wx:for="{{menus}}" wx:key="title" wx:for-item="m">
    <view class="menu-item" bindtap="goMenu" data-url="{{m.url}}">
      <view class="menu-title">{{m.title}}</view>
      <view class="menu-right">
        <view class="menu-dot" wx:if="{{m.dot}}"></view>
        <text class="muted" wx:if="{{m.value}}">{{m.value}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="skeleton" wx:if="{{loading}}" style="padding:24rpx">
    <view class="sk-line" style="width:100%;height:80rpx"></view>
    <view class="sk-line" style="width:100%;height:80rpx;margin-top:16rpx"></view>
  </view>
</view>
