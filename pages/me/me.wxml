<!-- 个人中心：用户卡 + 订单快捷入口 + 分组菜单 -->
<view class="page-wrap me-page">
  <view wx:if="{{loading}}" class="skeleton">
    <view class="sk-block" style="height:200rpx"></view>
    <view class="sk-block" style="height:140rpx"></view>
    <view class="sk-block" style="height:200rpx"></view>
  </view>

  <block wx:else>
    <!-- 用户卡 -->
    <view class="user-card">
      <image class="avatar" src="{{userInfo.avatarUrl || '/images/icons/person_active.png'}}" binderror="onImgError" data-key="userInfo.avatarUrl"></image>
      <view class="flex-1 user-info">
        <view class="username">{{userInfo.nickName || '鲜生活家'}}</view>
        <view class="level-badge">{{member.levelName}}</view>
      </view>
      <view class="user-stats">
        <view class="stat" bindtap="goVip"><view class="stat-num">{{points}}</view><view class="stat-label">积分</view></view>
        <view class="stat" bindtap="tapMenu" data-item="{{groups[0].items[3]}}"><view class="stat-num">{{couponCount}}</view><view class="stat-label">优惠券</view></view>
        <view class="stat" bindtap="tapMenu" data-item="{{groups[1].items[1]}}"><view class="stat-num">{{cartCount}}</view><view class="stat-label">购物车</view></view>
      </view>
    </view>

    <!-- 订单快捷入口 -->
    <view class="card order-quick">
      <view class="row-between section-title-sm">
        <view>我的订单</view>
        <view class="muted small" bindtap="goAllOrders">全部订单 ›</view>
      </view>
      <view class="quick-row">
        <view class="quick-item" wx:for="{{quickEntries}}" wx:key="key" bindtap="goOrderList" data-key="{{item.key}}">
          <view class="quick-icon-wrap">
            <image class="quick-icon" src="{{item.icon}}" binderror="onImgError" data-key="quickEntries[{{index}}].icon"></image>
            <view class="badge" wx:if="{{orderCounts[item.key] > 0}}">{{orderCounts[item.key]}}</view>
          </view>
          <view class="quick-name">{{item.name}}</view>
        </view>
      </view>
    </view>

    <!-- 菜单分组 -->
    <view class="card menu-group" wx:for="{{groups}}" wx:for-index="gi" wx:key="title">
      <view class="group-title">{{item.title}}</view>
      <view class="menu-item" wx:for="{{item.items}}" wx:for-item="m" wx:key="name" bindtap="tapMenu" data-item="{{m}}">
        <image class="menu-icon" src="{{m.icon}}" binderror="onImgError" data-key="groups[{{gi}}].items[{{index}}].icon"></image>
        <view class="flex-1 menu-name">{{m.name}}</view>
        <view class="red-dot" wx:if="{{m.redDot}}"></view>
        <view class="menu-arrow">›</view>
      </view>
    </view>
  </block>
</view>
