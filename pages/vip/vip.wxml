<view class="page-bg vip-page">
  <!-- 会员头 -->
  <view class="vip-header" wx:if="{{member}}">
    <view class="vip-level">{{member.levelName}}</view>
    <view class="vip-expire">有效期至 {{member.validDate}}</view>
    <view class="growth-bar">
      <view class="growth-fill" style="width: {{growthPercent}}%"></view>
    </view>
    <view class="growth-text">成长值 {{member.growthValue}} / {{member.nextLevelGrowth}}，距升级还差 {{member.nextLevelGrowth - member.growthValue}}</view>
    <view class="vip-points">
      <view class="points-num">{{member.points}}</view>
      <view class="points-label">我的积分</view>
    </view>
  </view>

  <!-- 生日福利横幅 -->
  <view class="birthday-banner" wx:if="{{birthdayGift}}" bindtap="goCoupon">
    <view class="birthday-icon">🎁</view>
    <view class="birthday-text">生日月专属礼包已到账：生日8.8折券 + 双倍积分卡，点击查看 ›</view>
  </view>

  <!-- 骨架屏 -->
  <view wx:if="{{loading}}">
    <view class="skeleton vip-skel"></view>
    <view wx:for="{{[1,2]}}" wx:key="this" class="skeleton goods-card"></view>
  </view>

  <block wx:else>
    <!-- 成长体系表 -->
    <view class="card">
      <view class="section-title">会员成长体系</view>
      <view class="tier-row {{member.levelName === item.level ? 'current' : ''}}" wx:for="{{growthTiers}}" wx:key="level">
        <view class="tier-level">{{item.level}}</view>
        <view class="tier-min">{{item.min}}成长值</view>
        <view class="tier-discount">{{item.discount}}</view>
        <view class="tier-freight">{{item.freeFreight}}</view>
      </view>
      <view class="growth-acquire">成长值获取：购物1元=1成长值 · 签到+5 · 评价+20</view>
    </view>

    <!-- 会员权益 -->
    <view class="card">
      <view class="section-title">会员权益</view>
      <view class="benefit-grid">
        <view class="benefit-item" wx:for="{{benefits}}" wx:key="name">
          <image mode="aspectFit" src="/https/images/icons/card_bag.png" binderror="onImgError" data-src="/https/images/icons/card_bag.png"></image>
          <view class="benefit-name">{{item.name}}</view>
          <view class="benefit-value">{{item.value}}</view>
        </view>
      </view>
    </view>

    <!-- 我的红包/优惠券 -->
    <view class="card" bindtap="goCoupon">
      <view class="section-title row-title">
        <text>我的红包 / 优惠券</text>
        <text class="all-link">查看全部 ›</text>
      </view>
      <view class="packet-row" wx:if="{{couponPackets.length > 0}}">
        <view class="packet" wx:for="{{couponPackets}}" wx:key="id">
          <view class="packet-amount">{{item.type === 2 ? (item.discount/10)+'折' : '¥'+item.discount}}</view>
          <view class="packet-name">{{item.name}}</view>
        </view>
      </view>
      <view class="empty-text" wx:else>暂无优惠券，去领券中心领取 →</view>
    </view>

    <!-- 会员专享商品 -->
    <view class="card">
      <view class="section-title">会员专享价</view>
      <view class="vip-goods-grid">
        <view class="vip-goods" wx:for="{{goods}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
          <image mode="aspectFill" src="{{item.pic}}" binderror="onImgError" data-src="{{item.pic}}"></image>
          <view class="ellipsis vip-goods-name">{{item.name}}</view>
          <view class="price-row">
            <text class="price-red">¥{{item.memberYuan}}</text>
            <text class="price-old">¥{{item.priceYuan}}</text>
          </view>
          <view class="vip-add" catchtap="addToCart" data-id="{{item.id}}">+</view>
        </view>
      </view>
    </view>
  </block>
</view>
