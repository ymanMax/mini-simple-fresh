/* 会员中心样式 */
.vip-page { padding-bottom: 40rpx; }
.vip-header {
  background: linear-gradient(135deg, #e4393c, #ff6b6b); color: #fff;
  padding: 40rpx 32rpx; display: flex; align-items: center; border-radius: 0 0 24rpx 24rpx;
}
.vip-avatar { width: 88rpx; height: 88rpx; border-radius: 50%; border: 3rpx solid #fff; background: #fff; }
.vip-name { font-size: 32rpx; font-weight: 800; margin-left: 16rpx; }
.vip-level { font-size: 22rpx; opacity: .9; margin-left: 16rpx; margin-top: 4rpx; }
.open-vip-btn { background: #fff; color: #e4393c; padding: 12rpx 28rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 700; }

.benefits { display: flex; flex-wrap: wrap; }
.benefit { width: 33.33%; text-align: center; padding: 16rpx 0; }
.benefit-icon { width: 64rpx; height: 64rpx; margin: 0 auto; }
.benefit-name { font-size: 22rpx; margin-top: 6rpx; color: #555; }

.redbags { display: flex; gap: 16rpx; }
.redbag { flex: 1; text-align: center; background: #fff1f0; border-radius: 12rpx; padding: 16rpx; }
.redbag-icon { width: 56rpx; height: 56rpx; margin: 0 auto; }
.redbag-name { font-size: 22rpx; color: #666; margin: 6rpx 0; }
.redbag-btn { background: #e4393c; color: #fff; padding: 6rpx 18rpx; border-radius: 999rpx; font-size: 20rpx; display: inline-block; }
.redbag-btn.got { background: #ccc; }

.vip-product { display: flex; padding: 14rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.vip-product:last-child { border-bottom: none; }
.vip-product-img { width: 110rpx; height: 110rpx; border-radius: 12rpx; margin-right: 16rpx; background: #f2f3f5; }
.vip-product-name { font-size: 28rpx; font-weight: 600; }
.mini-add { width: auto; padding: 6rpx 18rpx; border-radius: 999rpx; background: #e4393c; color: #fff; font-size: 22rpx; }

.vip-footer { text-align: center; padding: 30rpx; }
.open-vip-btn-sm { width: 240rpx; margin: 12rpx auto 0; }
.section-title-sm { font-size: 30rpx; font-weight: 700; margin-bottom: 12rpx; }

/* 成长值进度条（纯CSS，需求8.1） */
.growth-card { padding: 20rpx 24rpx; }
.growth-bar { width: 100%; height: 16rpx; background: #f2f3f5; border-radius: 999rpx; margin: 14rpx 0 8rpx; overflow: hidden; }
.growth-fill { height: 100%; background: linear-gradient(90deg, #e4393c, #ff7875); border-radius: 999rpx; transition: width .5s; }
.growth-tip { font-size: 20rpx; }

/* 生日礼包横幅 */
.birthday-banner { background: linear-gradient(135deg, #fff1f0, #ffe0dd); border-left: 6rpx solid #e4393c; padding: 20rpx 24rpx; }
.birthday-title { font-size: 28rpx; font-weight: 700; color: #e4393c; }

/* 成长体系表 */
.level-row { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #f5f5f5; font-size: 24rpx; }
.level-row:last-child { border-bottom: none; }
.level-row.current { color: #e4393c; font-weight: 700; }
.level-name { width: 160rpx; font-size: 26rpx; font-weight: 600; }
