.vip-page { padding-bottom: 60rpx; }

.vip-header {
  background: linear-gradient(135deg, #b8860b, #e4393c);
  padding: 40rpx 32rpx; color: #fff; border-radius: 0 0 24rpx 24rpx;
}
.vip-level { font-size: 40rpx; font-weight: 700; }
.vip-expire { font-size: 22rpx; opacity: .9; margin-top: 6rpx; }
.growth-bar { height: 12rpx; background: rgba(255,255,255,.3); border-radius: 999rpx; margin: 16rpx 0 8rpx; }
.growth-fill { height: 100%; background: #fff; border-radius: 999rpx; }
.growth-text { font-size: 20rpx; opacity: .9; }
.vip-points { margin-top: 20rpx; }
.points-num { font-size: 36rpx; font-weight: 700; }
.points-label { font-size: 22rpx; opacity: .9; }

.section-title { font-weight: 600; font-size: 28rpx; margin-bottom: 14rpx; }
.row-title { display: flex; justify-content: space-between; align-items: center; }
.all-link { color: #999; font-weight: normal; font-size: 24rpx; }

.benefit-grid { display: flex; flex-wrap: wrap; }
.benefit-item { width: 20%; display: flex; flex-direction: column; align-items: center; }
.benefit-item image { width: 56rpx; height: 56rpx; }
.benefit-name { font-size: 22rpx; margin-top: 6rpx; }
.benefit-value { font-size: 20rpx; color: #e4393c; margin-top: 2rpx; }

.packet-row { display: flex; gap: 12rpx; flex-wrap: wrap; }
.packet {
  background: #fdecec; border-radius: 12rpx; padding: 16rpx 24rpx; text-align: center;
}
.packet-amount { color: #e4393c; font-size: 30rpx; font-weight: bold; }
.packet-name { font-size: 20rpx; color: #666; margin-top: 4rpx; }

.vip-goods-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.vip-goods { width: 31%; position: relative; }
.vip-goods image { width: 100%; height: 180rpx; border-radius: 12rpx; }
.vip-goods-name { font-size: 22rpx; margin-top: 6rpx; }
.price-row { display: flex; align-items: baseline; gap: 8rpx; }
.vip-add {
  position: absolute; right: 4rpx; bottom: 40rpx; width: 40rpx; height: 40rpx;
  line-height: 36rpx; text-align: center; border-radius: 50%;
  background: #e4393c; color: #fff; font-size: 30rpx;
}

.vip-skel { height: 200rpx; margin: 0 0 16rpx; border-radius: 16rpx; }
.empty-text { color: #999; font-size: 24rpx; }

/* 生日福利 */
.birthday-banner {
  display: flex; align-items: center; margin: 16rpx 24rpx;
  background: linear-gradient(135deg, #ff9500, #e4393c);
  color: #fff; border-radius: 16rpx; padding: 20rpx 24rpx;
}
.birthday-icon { font-size: 40rpx; margin-right: 12rpx; }
.birthday-text { font-size: 24rpx; }

/* 成长体系表 */
.tier-row { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 2rpx solid #f5f6f7; }
.tier-row.current { background: #fdecec; border-radius: 8rpx; padding: 14rpx 12rpx; }
.tier-level { width: 100rpx; font-weight: 600; font-size: 26rpx; }
.tier-row.current .tier-level { color: #e4393c; }
.tier-min { flex: 1; font-size: 22rpx; color: #999; }
.tier-discount { width: 100rpx; font-size: 24rpx; font-weight: 600; }
.tier-freight { width: 140rpx; font-size: 22rpx; color: #666; text-align: right; }
.growth-acquire { color: #999; font-size: 20rpx; margin-top: 12rpx; }
