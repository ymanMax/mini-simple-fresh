.vip-page { padding-bottom: 40rpx; }

.vip-header {
  background: linear-gradient(135deg, #b8860b, #e93b3d);
  margin: 24rpx;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  color: #fff;
}
.vh-top { display: flex; justify-content: space-between; align-items: center; }
.vh-level-badge {
  background: rgba(255,255,255,.25);
  border: 2rpx solid rgba(255,255,255,.6);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: bold;
}
.vh-right { text-align: right; }
.vh-points { font-size: 28rpx; font-weight: bold; }
.vh-valid { font-size: 20rpx; opacity: 0.9; margin-top: 4rpx; }
.vh-nick { font-size: 26rpx; margin-top: 16rpx; opacity: 0.95; }

/* 成长值进度条 */
.growth-bar-wrap { margin-top: 24rpx; }
.growth-bar { height: 16rpx; background: rgba(255,255,255,.25); border-radius: 999rpx; overflow: hidden; }
.growth-fill { height: 100%; background: #fff; border-radius: 999rpx; transition: width .4s; }
.growth-text { display: flex; justify-content: space-between; font-size: 20rpx; opacity: 0.9; margin-top: 8rpx; }

.vh-save { font-size: 24rpx; margin-top: 24rpx; opacity: 0.95; }
.vh-save text { font-size: 28rpx; font-weight: bold; }
.vh-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.vh-open, .vh-checkin {
  background: #fff; color: #b8860b;
  font-size: 24rpx; padding: 12rpx 28rpx; border-radius: 999rpx;
}
.vh-checkin { background: rgba(255,255,255,.25); color: #fff; }

/* 生日横幅 */
.birthday-banner {
  margin: 0 24rpx 16rpx;
  background: linear-gradient(135deg, #ffd6e0, #ffb3c6);
  color: #c2185b;
  border-radius: 16rpx;
  padding: 20rpx 32rpx;
  font-size: 26rpx;
}

.block-title { font-size: 30rpx; font-weight: bold; margin-bottom: 12rpx; }

/* 成长体系表 */
.level-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 10rpx;
}
.level-row.current { background: #fdecec; outline: 2rpx solid #e93b3d; }
.lv-name { font-size: 28rpx; font-weight: bold; }
.lv-threshold { font-size: 20rpx; color: #838383; margin-top: 4rpx; }
.lv-right { text-align: right; }
.lv-discount { font-size: 28rpx; font-weight: bold; color: #e93b3d; }
.lv-priv { font-size: 20rpx; color: #838383; max-width: 320rpx; margin-top: 4rpx; }
.growth-note { font-size: 22rpx; color: #b0b0b0; text-align: center; padding: 8rpx 0; }

/* 权益 */
.priv-grid { display: flex; flex-wrap: wrap; }
.priv-item { width: 25%; text-align: center; padding: 16rpx 0; }
.priv-icon { font-size: 36rpx; color: #e93b3d; }
.priv-name { font-size: 20rpx; color: #555; margin-top: 6rpx; line-height: 1.3; }

/* 红包 */
.redpack-grid { display: flex; gap: 16rpx; }
.redpack {
  flex: 1;
  background: linear-gradient(135deg, #ff6b6b, #e93b3d);
  color: #fff;
  border-radius: 16rpx;
  padding: 24rpx 0;
  text-align: center;
}
.redpack.disabled { background: #ddd; }
.rp-amount { font-size: 38rpx; font-weight: bold; }
.rp-name { font-size: 22rpx; margin-top: 4rpx; }
.rp-reason { font-size: 18rpx; margin-top: 4rpx; opacity: 0.9; }

/* 会员商品横滑 */
.vip-product-scroll { white-space: nowrap; padding: 0 16rpx; }
.vp-card {
  display: inline-block;
  width: 240rpx;
  margin: 0 12rpx;
  vertical-align: top;
  background: #fff;
  border-radius: 16rpx;
  padding: 12rpx;
}
.vp-card image { width: 100%; height: 200rpx; border-radius: 12rpx; background: #f0f0f0; }
.vp-name { font-size: 24rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 8rpx; line-height: 1.4; }
.vp-price-row { display: flex; align-items: baseline; gap: 8rpx; margin-top: 4rpx; }
.vp-vip { font-size: 28rpx; }
.vp-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 6rpx; }
.arrive { font-size: 20rpx; color: #ff9500; }
.add-btn {
  width: 44rpx; height: 44rpx; line-height: 40rpx; text-align: center;
  background: #e93b3d; color: #fff; border-radius: 50%; font-size: 30rpx; font-weight: bold;
}
.nomore { text-align: center; color: #b0b0b0; font-size: 24rpx; padding: 32rpx 0; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
