.vip-page { min-height: 100vh; padding-bottom: 40rpx; }
.vip-header { background: linear-gradient(135deg,#6a5ae0,#8e6bff); padding: 36rpx 24rpx; color: #fff; border-radius: 0 0 24rpx 24rpx; }
.vh-row { display: flex; align-items: center; }
.vh-avatar { width: 100rpx; height: 100rpx; border: 3rpx solid rgba(255,255,255,.5); }
.vh-info { margin-left: 18rpx; flex: 1; }
.vh-name { font-size: 32rpx; font-weight: 700; }
.vh-level { font-size: 22rpx; opacity: .9; margin-top: 4rpx; }
.vh-open { background: #ffd740; color: #6a4a00; font-size: 24rpx; padding: 10rpx 24rpx; border-radius: 28rpx; font-weight: 700; }
.vh-save { margin-top: 18rpx; font-size: 24rpx; opacity: .95; }
.vh-amount { font-size: 30rpx; font-weight: 700; }

.priv-card { margin-top: 16rpx; }
.priv-grid { display: flex; flex-wrap: wrap; }
.priv-item { width: 33.3%; display: flex; flex-direction: column; align-items: center; padding: 12rpx 0; }
.priv-icon { width: 70rpx; height: 70rpx; }
.priv-name { font-size: 24rpx; font-weight: 600; margin-top: 6rpx; }
.priv-desc { font-size: 18rpx; text-align: center; padding: 0 8rpx; }

.redbag-row { display: flex; gap: 16rpx; }
.redbag { flex: 1; background: linear-gradient(135deg,#ff6b6b,#ff3b30); color: #fff; border-radius: 12rpx; padding: 16rpx; text-align: center; }
.redbag.received { background: #ccc; }
.rb-amount { font-size: 34rpx; font-weight: 700; }
.rb-cond { font-size: 18rpx; opacity: .9; }
.rb-name { font-size: 22rpx; margin: 6rpx 0; }
.rb-btn { background: #fff; color: #ff3b30; font-size: 20rpx; border-radius: 20rpx; padding: 4rpx 14rpx; display: inline-block; }
.rb-btn.got { background: #eee; color: #999; }

.section-title { font-size: 28rpx; font-weight: 700; margin: 16rpx 28rpx 8rpx; }
.vip-product { display: flex; align-items: center; padding: 16rpx; margin: 0 24rpx 14rpx; }
.vp-pic { width: 110rpx; height: 110rpx; margin-right: 14rpx; }
.vp-info { flex: 1; }
.vp-name { font-size: 26rpx; font-weight: 600; }
.vp-sub { font-size: 20rpx; margin-top: 2rpx; }
.vp-price-row { margin-top: 6rpx; display: flex; align-items: baseline; gap: 10rpx; }

.birthday-banner { background: linear-gradient(90deg,#ffd740,#ffb347); color: #6a4a00; margin: 16rpx 24rpx; border-radius: 12rpx; padding: 16rpx 24rpx; font-size: 24rpx; text-align: center; font-weight: 600; }
.growth-row { margin-top: 14rpx; }
.growth-label { font-size: 22rpx; opacity: .95; }
.growth-bar { height: 12rpx; background: rgba(255,255,255,.3); border-radius: 6rpx; margin: 8rpx 0; overflow: hidden; }
.growth-fill { height: 100%; background: #fff; border-radius: 6rpx; }
.growth-next { font-size: 20rpx; opacity: .9; }
.level-table { }
.level-row { display: flex; justify-content: space-between; align-items: center; padding: 10rpx 0; border-bottom: 1rpx solid #f2f2f2; }
.level-row.current { background: #fff1f0; border-radius: 8rpx; padding: 10rpx 12rpx; }
.level-name { font-size: 26rpx; font-weight: 700; }
.growth-tip { font-size: 20rpx; margin-top: 10rpx; }
.vp-scroll { white-space: nowrap; padding: 0 24rpx 16rpx; }
.vip-product { display: inline-flex; width: 320rpx; background: #fff; border-radius: 14rpx; margin-right: 14rpx; padding: 12rpx; align-items: center; }
.member-tag { font-size: 18rpx; background: #ff8c00; color: #fff; padding: 1rpx 10rpx; border-radius: 10rpx; margin-right: 6rpx; }
.quick-row { display: flex; justify-content: space-around; padding: 16rpx 24rpx; }
.quick-item { display: flex; flex-direction: column; align-items: center; }
.quick-icon { font-size: 40rpx; }
.quick-label { font-size: 22rpx; margin-top: 4rpx; color: #555; }
