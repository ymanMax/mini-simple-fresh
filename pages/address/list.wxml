<!-- 地址列表 -->
<view class="page-wrap">
  <view wx:if="{{loading}}" class="skeleton">
    <view class="sk-block" style="height:140rpx"></view>
    <view class="sk-block" style="height:140rpx"></view>
  </view>

  <block wx:else>
    <view wx:if="{{addresses.length==0}}" class="empty">
      <image class="empty-img" src="/images/default.png" binderror="onImgError" data-key="emptyImg"></image>
      <view class="empty-title">暂无收货地址</view>
      <view class="empty-sub">添加地址，方便快速结算</view>
      <view class="btn-primary go-shop-btn" bindtap="addNew">新增地址</view>
    </view>

    <view class="addr-card" wx:for="{{addresses}}" wx:key="id" bindtap="tapAddress" data-id="{{item.id}}">
      <view class="row-between">
        <view class="row">
          <view class="addr-name">{{item.name}}</view>
          <view class="addr-phone">{{item.phone}}</view>
          <view class="tag" wx:if="{{item.isDefault}}">默认</view>
          <view class="tag tag-gray">{{item.tag}}</view>
        </view>
      </view>
      <view class="addr-detail">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</view>
      <view class="addr-actions">
        <view class="action-link" bindtap="setDefault" data-id="{{item.id}}">设为默认</view>
        <view class="action-link" bindtap="edit" data-id="{{item.id}}">编辑</view>
        <view class="action-link danger" bindtap="remove" data-id="{{item.id}}">删除</view>
      </view>
    </view>

    <view class="add-wrap">
      <view class="btn-primary add-btn" bindtap="addNew">+ 新增收货地址</view>
    </view>
  </block>
</view>
