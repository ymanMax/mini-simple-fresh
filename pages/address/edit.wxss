.edit-page { padding-bottom: 180rpx; }

.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}
.form-row:last-child { border-bottom: none; }
.form-row.column { flex-direction: column; align-items: stretch; }
.form-label { font-size: 28rpx; width: 140rpx; flex-shrink: 0; color: #333; }
.form-row input { flex: 1; font-size: 28rpx; }
.detail-input {
  width: 100%;
  background: #f0f1f3;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 12rpx;
  min-height: 120rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}
.picker-value { font-size: 28rpx; color: #555; }

.switch {
  width: 80rpx; height: 44rpx;
  background: #ddd;
  border-radius: 999rpx;
  position: relative;
  transition: background .2s;
}
.switch.on { background: #e93b3d; }
.switch-dot {
  position: absolute;
  top: 4rpx; left: 4rpx;
  width: 36rpx; height: 36rpx;
  background: #fff;
  border-radius: 50%;
  transition: left .2s;
}
.switch.on .switch-dot { left: 40rpx; }

.save-bar {
  position: fixed;
  left: 24rpx; right: 24rpx; bottom: 32rpx;
}
