/* 地址列表样式 */
.addr-card { background: #fff; border-radius: 16rpx; margin: 16rpx 24rpx; padding: 24rpx; }
.addr-name { font-size: 30rpx; font-weight: 700; margin-right: 12rpx; }
.addr-phone { font-size: 26rpx; color: #666; margin-right: 12rpx; }
.addr-detail { font-size: 26rpx; color: #555; margin: 12rpx 0; line-height: 1.5; }
.addr-actions { display: flex; justify-content: flex-end; gap: 24rpx; border-top: 1rpx solid #f5f5f5; padding-top: 12rpx; }
.action-link { font-size: 24rpx; color: #666; padding: 4rpx 12rpx; }
.action-link.danger { color: #e4393c; }
.add-wrap { padding: 24rpx; }
.add-btn { height: 80rpx; line-height: 80rpx; font-size: 30rpx; }
.go-shop-btn { width: 240rpx; margin: 0 auto; }
