<!-- 地址编辑表单 -->
<view class="page-wrap edit-page">
  <view class="card form-card">
    <view class="form-row">
      <text class="form-label">收货人</text>
      <input class="form-input" placeholder="请输入姓名" value="{{form.name}}" bindinput="onInput" data-field="name" />
    </view>
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" placeholder="11位手机号" value="{{form.phone}}" bindinput="onInput" data-field="phone" maxlength="11" />
    </view>
    <view class="form-row">
      <text class="form-label">省份</text>
      <input class="form-input" value="北京市" disabled />
    </view>
    <view class="form-row">
      <text class="form-label">城市</text>
      <input class="form-input" value="北京市" disabled />
    </view>
    <view class="form-row">
      <text class="form-label">所在区</text>
      <view class="district-row">
        <view class="district {{form.district==d?'active':''}}" wx:for="{{districts}}" wx:key="*this" bindtap="pickDistrict" data-idx="{{index}}">{{d}}</view>
      </view>
    </view>
    <view class="form-row column">
      <text class="form-label">详细地址</text>
      <textarea class="form-textarea" placeholder="街道、楼栋、门牌号等" value="{{form.detail}}" bindinput="onInput" data-field="detail" maxlength="100"></textarea>
    </view>
    <view class="form-row">
      <text class="form-label">标签</text>
      <view class="tag-row">
        <view class="tag {{form.tag==t?'tag-selected':''}}" wx:for="{{tags}}" wx:key="*this" bindtap="pickTag" data-tag="{{t}}">{{t}}</view>
      </view>
    </view>
    <view class="form-row">
      <text class="form-label">设为默认</text>
      <view class="switch {{form.isDefault?'on':''}}" bindtap="toggleDefault"></view>
    </view>
  </view>

  <view class="save-wrap">
    <view class="btn-primary save-btn" bindtap="save">{{isEdit?'保存修改':'新增地址'}}</view>
  </view>
</view>
