<view class="edit-page">
  <view class="card form-card">
    <view class="form-row">
      <text class="form-label">收货人</text>
      <input placeholder="请输入姓名" value="{{name}}" data-field="name" bindinput="onField" />
    </view>
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input type="number" maxlength="11" placeholder="请输入11位手机号" value="{{phone}}" data-field="phone" bindinput="onField" />
    </view>
    <view class="form-row">
      <text class="form-label">省份</text>
      <picker range="{{provinces}}" value="{{provinceIndex}}" bindchange="pickProvince">
        <view class="picker-value">{{province}} ›</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">城市</text>
      <input placeholder="如：北京市" value="{{city}}" data-field="city" bindinput="onField" />
    </view>
    <view class="form-row">
      <text class="form-label">区/县</text>
      <input placeholder="如：朝阳区" value="{{district}}" data-field="district" bindinput="onField" />
    </view>
    <view class="form-row column">
      <text class="form-label">详细地址</text>
      <textarea class="detail-input" placeholder="街道、门牌号、楼栋单元等" value="{{detail}}" data-field="detail" bindinput="onField" maxlength="100"></textarea>
    </view>
    <view class="form-row">
      <text class="form-label">标签</text>
      <picker range="{{tags}}" value="{{tagIndex}}" bindchange="pickTag">
        <view class="picker-value">{{tag}} ›</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">设为默认</text>
      <view class="switch {{isDefault ? 'on' : ''}}" bindtap="toggleDefault">
        <view class="switch-dot"></view>
      </view>
    </view>
  </view>

  <view class="save-bar">
    <view class="btn-primary" bindtap="save">保存地址</view>
  </view>
</view>
