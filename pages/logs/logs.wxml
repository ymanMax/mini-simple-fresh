<!-- 启动日志页 -->
<view class="page-wrap logs-page">
  <view wx:if="{{loading}}" class="skeleton"><view class="sk-block" style="height:140rpx"></view></view>
  <block wx:else>
    <view wx:if="{{logs.length==0}}" class="empty">
      <image class="empty-img" src="/images/default.png" binderror="onImgError" data-key="emptyImg"></image>
      <view class="empty-title">暂无日志</view>
    </view>
    <view class="card log-card" wx:for="{{logs}}" wx:key="ts">
      <view class="row-between">
        <view class="log-index">第 {{item.index}} 次启动</view>
        <view class="muted small">{{item.time}}</view>
      </view>
    </view>
    <view class="clear-wrap" wx:if="{{logs.length>0}}">
      <view class="btn-primary clear-btn" bindtap="clearLogs">清空日志</view>
    </view>
  </block>
</view>
