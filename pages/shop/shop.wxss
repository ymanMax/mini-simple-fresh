.shop-page { min-height: 100vh; padding-bottom: 140rpx; }
.freight-hint { background: #fff1f0; color: #ff3b30; font-size: 24rpx; text-align: center; padding: 14rpx 24rpx; margin: 16rpx 24rpx 0; border-radius: 12rpx; }

.cart-item { display: flex; align-items: center; padding: 20rpx; position: relative; }
.checkbox { flex-shrink: 0; }
.item-pic { width: 140rpx; height: 140rpx; margin: 0 16rpx; }
.item-pic.gray { filter: grayscale(1); opacity: .6; }
.item-info { flex: 1; }
.item-name { font-size: 27rpx; font-weight: 600; line-height: 1.4; }
.item-spec { font-size: 22rpx; margin-top: 4rpx; }
.item-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.item-del { padding: 8rpx 12rpx; font-size: 32rpx; }
.disabled { color: #999; }

.invalid-section { padding: 16rpx; }
.invalid-head { display: flex; justify-content: space-between; font-size: 26rpx; font-weight: 600; padding: 4rpx 8rpx 12rpx; }
.invalid-clear { color: #ff3b30; font-size: 24rpx; font-weight: 400; }
.invalid-item { padding: 12rpx 8rpx; }

.section-title { font-size: 28rpx; font-weight: 700; padding: 16rpx 28rpx 8rpx; }
.rec-scroll { white-space: nowrap; padding: 0 24rpx; }
.rec-item { display: inline-block; width: 150rpx; margin-right: 14rpx; text-align: center; position: relative; }
.rec-pic { width: 150rpx; height: 150rpx; }
.rec-name { font-size: 20rpx; margin-top: 4rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rec-add { position: absolute; right: 4rpx; bottom: 28rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: #ff3b30; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 26rpx; }

.footer-bar { justify-content: flex-start; gap: 16rpx; }
.total { flex: 1; }
.total .muted { font-size: 22rpx; }
.checkout-btn { background: linear-gradient(90deg,#ff5b4f,#ff3b30); color: #fff; padding: 18rpx 48rpx; border-radius: 44rpx; font-size: 28rpx; font-weight: 600; }

.promo-detail { padding: 16rpx 24rpx; }
.pd-row { display: flex; justify-content: space-between; font-size: 25rpx; padding: 6rpx 0; color: #555; }
