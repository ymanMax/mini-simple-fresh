<!-- 积分页：余额卡 + 积分明细 + 兑换专区 -->
<view class="page-wrap">
  <!-- 积分余额 -->
  <view class="points-header" wx:if="{{member}}">
    <view class="points-num">{{member.points}}</view>
    <view class="points-label">当前积分</view>
    <view class="points-sub">{{member.levelName}} · 成长值 {{member.growthValue}}/{{member.nextLevelGrowth}}</view>
  </view>

  <view wx:if="{{loading}}" class="skeleton">
    <view class="sk-block" style="height:140rpx"></view>
    <view class="sk-block" style="height:140rpx"></view>
  </view>

  <block wx:else>
    <!-- 积分明细 -->
    <view class="card">
      <view class="section-title-sm">积分明细</view>
      <view wx:if="{{records.length==0}}" class="muted" style="padding:20rpx 0">暂无积分记录</view>
      <view class="record-item" wx:for="{{records}}" wx:key="id">
        <view class="flex-1">
          <view class="record-desc">{{item.desc}}</view>
          <view class="muted small">{{item.createTime}}</view>
        </view>
        <view class="record-points {{item.points>0?'plus':'minus'}}">{{item.points>0?'+':''}}{{item.points}}</view>
      </view>
    </view>

    <!-- 兑换专区 -->
    <view class="card">
      <view class="section-title-sm">积分兑换</view>
      <view class="gift-item" wx:for="{{gifts}}" wx:key="id">
        <image class="gift-img" src="{{item.pic}}" binderror="onImgError" data-key="gifts[{{index}}].pic"></image>
        <view class="flex-1">
          <view class="gift-name">{{item.name}}</view>
          <view class="muted small">{{item.desc}}</view>
          <view class="gift-points">{{item.points}} 积分</view>
        </view>
        <view class="exchange-btn" bindtap="exchange" data-id="{{item.id}}">兑换</view>
      </view>
    </view>
  </block>
</view>
