/* 积分页样式 */
.points-header {
  background: linear-gradient(135deg, #e4393c, #ff6b6b); color: #fff;
  padding: 48rpx 32rpx; text-align: center; border-radius: 0 0 24rpx 24rpx;
}
.points-num { font-size: 56rpx; font-weight: 800; }
.points-label { font-size: 24rpx; opacity: .9; }
.points-sub { font-size: 22rpx; opacity: .8; margin-top: 8rpx; }

.record-item { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.record-item:last-child { border-bottom: none; }
.record-desc { font-size: 28rpx; }
.record-points { font-size: 30rpx; font-weight: 700; }
.record-points.plus { color: #52c41a; }
.record-points.minus { color: #e4393c; }

.gift-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.gift-item:last-child { border-bottom: none; }
.gift-img { width: 80rpx; height: 80rpx; border-radius: 12rpx; margin-right: 16rpx; background: #f2f3f5; }
.gift-name { font-size: 28rpx; font-weight: 600; }
.gift-points { font-size: 24rpx; color: #e4393c; font-weight: 700; margin-top: 4rpx; }
.exchange-btn {
  background: #e4393c; color: #fff; padding: 10rpx 28rpx; border-radius: 999rpx; font-size: 24rpx;
}
.section-title-sm { font-size: 30rpx; font-weight: 700; margin-bottom: 12rpx; }
