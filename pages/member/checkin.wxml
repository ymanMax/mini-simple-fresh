<!-- 每日签到：当月日历7列网格、7天梯度奖励、连签天数、翻月、签到按钮 -->
<view class="page-wrap checkin-page">
  <view wx:if="{{loading}}" class="skeleton"><view class="sk-block" style="height:300rpx"></view></view>

  <block wx:else>
    <!-- 积分与连续签到 -->
    <view class="checkin-header">
      <view class="points-num">{{member.points}}</view>
      <view class="points-label">我的积分</view>
      <view class="consecutive">连续签到 {{member.checkIn.consecutive}} 天</view>
      <view class="muted small" style="opacity:.8">中断后连续天数重新计算</view>
    </view>

    <!-- 翻月日历 -->
    <view class="card cal-card">
      <view class="row-between">
        <view class="month-nav" bindtap="prevMonth">‹ 上月</view>
        <view class="section-title-sm">{{monthLabel}}</view>
        <view class="month-nav" bindtap="nextMonth">下月 ›</view>
      </view>
      <view class="cal-week">
        <view class="cal-dow" wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="cal-grid">
        <view class="cal-cell {{cell.empty?'empty':''}} {{cell.isToday?'today':''}} {{cell.checked?'checked':''}} {{cell.future?'future':''}}"
              wx:for="{{calendar}}" wx:key="index">{{cell.day}}</view>
      </view>
    </view>

    <!-- 7天梯度奖励条 -->
    <view class="card">
      <view class="section-title-sm">连续签到奖励（7天一循环）</view>
      <view class="reward-row">
        <view class="reward-item" wx:for="{{rewards}}" wx:key="index">
          <view class="reward-day">第{{index+1}}天</view>
          <view class="reward-points">+{{item}}积分</view>
          <view class="reward-dot {{member.checkIn.consecutive>index?'done':''}}"></view>
        </view>
      </view>
    </view>

    <!-- 签到按钮 -->
    <view class="sign-btn-wrap">
      <view class="btn-primary sign-btn {{checked?'btn-disabled':''}} {{checkinAnim?'anim':''}}" bindtap="doSign">{{checked?'今日已签到':'立即签到（领积分）'}}</view>
    </view>
  </block>
</view>
