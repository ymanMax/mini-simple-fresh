/* 签到页样式 */
.checkin-page { padding-bottom: 40rpx; }
.checkin-header {
  background: linear-gradient(135deg, #e4393c, #ff6b6b); color: #fff;
  padding: 40rpx 32rpx; text-align: center; border-radius: 0 0 24rpx 24rpx;
}
.points-num { font-size: 52rpx; font-weight: 800; }
.points-label { font-size: 24rpx; opacity: .9; }
.consecutive { font-size: 26rpx; font-weight: 700; margin-top: 12rpx; }

.cal-card { padding: 16rpx 20rpx; }
.month-nav { font-size: 24rpx; color: #e4393c; padding: 8rpx 12rpx; }
.cal-week { display: flex; }
.cal-dow { flex: 1; text-align: center; font-size: 24rpx; color: #999; padding: 8rpx 0; }
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell {
  width: calc(100%/7); text-align: center; padding: 14rpx 0; font-size: 26rpx;
  border-radius: 50%; margin: 4rpx; position: relative;
}
.cal-cell.empty { visibility: hidden; }
.cal-cell.today { background: #e4393c; color: #fff; font-weight: 700; }
.cal-cell.checked { color: #e4393c; font-weight: 600; }
.cal-cell.checked::after { content: '✓'; position: absolute; bottom: 2rpx; right: 6rpx; font-size: 14rpx; color: #52c41a; }
.cal-cell.future { color: #ccc; }

.reward-row { display: flex; justify-content: space-between; padding: 12rpx 0; }
.reward-item { text-align: center; width: 13%; position: relative; }
.reward-day { font-size: 20rpx; color: #999; }
.reward-points { font-size: 22rpx; color: #e4393c; font-weight: 700; margin-top: 4rpx; }
.reward-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #ddd; margin: 6rpx auto 0; }
.reward-dot.done { background: #e4393c; }

.sign-btn-wrap { padding: 30rpx 24rpx; }
.sign-btn { height: 88rpx; line-height: 88rpx; font-size: 30rpx; }
.sign-btn.anim { animation: breathe 0.6s ease-in-out infinite; }
.section-title-sm { font-size: 30rpx; font-weight: 700; margin-bottom: 12rpx; }
