.company-page { padding-bottom: 60rpx; }
.shop-header {
  background: linear-gradient(135deg, #e4393c, #f08080);
  padding: 40rpx 32rpx; color: #fff; display: flex; flex-direction: column; align-items: center;
}
.shop-logo { width: 100rpx; height: 100rpx; border-radius: 50%; border: 3rpx solid rgba(255,255,255,.6); }
.shop-name { font-size: 32rpx; font-weight: 600; margin-top: 12rpx; }
.shop-rating { font-size: 24rpx; opacity: .9; margin-top: 6rpx; }
.shop-tags { margin-top: 12rpx; display: flex; gap: 8rpx; flex-wrap: wrap; justify-content: center; }
.shop-header .tag-pill { background: rgba(255,255,255,.25); color: #fff; }

.top-tabs { display: flex; background: #fff; position: sticky; top: 0; z-index: 10; }
.top-tabs .tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; color: #555; }
.top-tabs .tab.active { color: #e4393c; font-weight: 600; border-bottom: 4rpx solid #e4393c; }

.section-title { font-weight: 600; font-size: 28rpx; margin-bottom: 12rpx; }
.para { color: #555; font-size: 26rpx; line-height: 1.8; }

.shop-review { padding: 14rpx 0; border-bottom: 2rpx solid #f5f6f7; }
.review-head { display: flex; align-items: center; gap: 12rpx; }
.avatar { width: 56rpx; height: 56rpx; border-radius: 50%; }
.review-user { font-size: 26rpx; font-weight: 500; }
.stars { margin-left: auto; color: #ff9500; font-size: 24rpx; }
.review-content { margin-top: 8rpx; font-size: 26rpx; color: #444; line-height: 1.6; }
.review-time { color: #aaa; font-size: 20rpx; margin-top: 6rpx; }
.review-skel { height: 120rpx; }
