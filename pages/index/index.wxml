<!-- 首页：搜索入口 + banner + 金刚区 + 商品列表 -->
<view class="page-wrap">
  <!-- 搜索栏 -->
  <view class="search-bar" bindtap="goSearch">
    <image class="search-icon" src="/images/icons/search.png" binderror="onImgError" data-key="searchIcon"></image>
    <text class="search-placeholder">搜索当季水果、蔬菜、肉类…</text>
  </view>

  <!-- 骨架屏 -->
  <view wx:if="{{loading}}" class="skeleton">
    <view class="sk-block" style="height:300rpx"></view>
    <view class="sk-block" style="height:120rpx"></view>
    <view class="sk-block" style="height:180rpx"></view>
    <view class="sk-block" style="height:180rpx"></view>
  </view>

  <block wx:else>
    <!-- banner -->
    <swiper class="banner" interval="3000" autoplay circular indicator-dots indicator-color="#ddd" indicator-active-color="#e4393c">
      <swiper-item wx:for="{{banners}}" wx:key="id" bindtap="tapBanner" data-link="{{item.link}}">
        <image class="banner-img" src="{{item.path}}" mode="aspectFill" binderror="onImgError" data-key="banners[{{index}}].path"></image>
      </swiper-item>
    </swiper>

    <!-- 金刚区 lanternArea -->
    <view class="lanternArea card">
      <view class="lantern-item" wx:for="{{lanternArea}}" wx:key="id" bindtap="tapLantern" data-link="{{item.link}}">
        <image class="lantern-icon" src="{{item.image}}" mode="aspectFit" binderror="onImgError" data-key="lanternArea[{{index}}].image"></image>
        <view class="lantern-name">{{item.name}}</view>
      </view>
    </view>

    <!-- tileArea -->
    <view class="tileArea card">
      <view class="tile-item" wx:for="{{tileArea}}" wx:key="id" bindtap="tapLantern" data-link="{{item.link}}">
        <image class="tile-icon" src="{{item.image}}" mode="aspectFit" binderror="onImgError" data-key="tileArea[{{index}}].image"></image>
        <view class="tile-name">{{item.name}}</view>
      </view>
    </view>

    <!-- 需求9.3：首页限时抢购模块（标题+倒计时+"更多>"跳促销页；横滑商品卡：抢购价/原价划线/进度条） -->
    <view class="card seckill-home">
      <view class="row-between">
        <view class="section-title-sm seckill-title">⚡ 限时抢购</view>
        <view class="countdown-mini">{{countdown}}</view>
        <view class="more-link" bindtap="goPromotion">更多 ›</view>
      </view>
      <scroll-view scroll-x class="h-scroll" style="padding:8rpx 0">
        <view class="h-scroll-item home-seckill-card" wx:for="{{seckillGoods}}" wx:key="goodsId">
          <image class="home-seckill-img" src="{{item.pic}}" mode="aspectFill" binderror="onImgError" data-key="seckillGoods[{{index}}].pic" bindtap="goPromotion"></image>
          <view class="home-seckill-name">{{item.name}}</view>
          <view class="row-between">
            <view class="price-sm seckill-price">¥{{item.seckillPrice/100}}</view>
            <view class="price-origin">¥{{item.originalPrice/100}}</view>
          </view>
          <view class="progress-bar">
            <view class="progress-fill" style="width:{{item.soldPercent}}%"></view>
          </view>
          <view class="row-between">
            <view class="muted small">已抢{{item.soldPercent}}% · 剩{{item.stock}}份</view>
            <view class="seckill-mini-btn" catchtap="seckillBuy" data-id="{{item.goodsId}}">马上抢</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 热销标题 -->
    <view class="section-title">
      <image src="/images/hot.png" class="hot-icon" binderror="onImgError" data-key="hotIcon"></image>
      <text>今日热销</text>
    </view>

    <!-- 商品列表 -->
    <view class="goods-list">
      <view class="goods-card" wx:for="{{goods}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <image class="goods-img" src="{{item.pic}}" mode="aspectFill" binderror="onImgError" data-key="goods[{{index}}].pic"></image>
        <view class="goods-info">
          <view class="goods-name">{{item.name}}</view>
          <view class="goods-sub">{{item.subtitle}} · {{item.origin}}直发</view>
          <view class="tag-row">
            <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
          </view>
          <view class="row-between">
            <view class="price-sm">¥{{item.price/100}}<text class="price-origin">¥{{item.originalPrice/100}}</text></view>
            <view class="add-btn" catchtap="addCart" data-id="{{item.id}}">+</view>
          </view>
        </view>
      </view>
    </view>

    <view class="nomore" wx:if="{{noMore}}"><text>没有更多了~</text></view>
  </block>
</view>
