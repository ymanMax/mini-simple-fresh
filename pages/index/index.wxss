.index-page { padding-bottom: 40rpx; }
.banner { width: 702rpx; height: 300rpx; margin: 16rpx 24rpx 0; border-radius: 16rpx; overflow: hidden; }
.banner-img { width: 100%; height: 100%; }

.nav-grid { display: flex; flex-wrap: wrap; background: #fff; margin: 20rpx 24rpx; border-radius: 16rpx; padding: 20rpx 0; }
.nav-item { width: 25%; display: flex; flex-direction: column; align-items: center; padding: 12rpx 0; }
.nav-icon { width: 88rpx; height: 88rpx; }
.nav-name { font-size: 24rpx; color: #555; margin-top: 8rpx; }

.seckill { margin: 20rpx 24rpx; padding: 20rpx; }
.seckill-head { display: flex; align-items: baseline; margin-bottom: 16rpx; }
.seckill-title { font-size: 30rpx; font-weight: 700; color: #ff3b30; }
.seckill-sub { font-size: 22rpx; color: #999; margin-left: 12rpx; }
.seckill-scroll { white-space: nowrap; }
.seckill-item { display: inline-block; width: 150rpx; margin-right: 16rpx; text-align: center; }
.seckill-pic { width: 150rpx; height: 150rpx; }
.seckill-price { font-weight: 700; font-size: 28rpx; margin: 6rpx 0; }
.seckill-bar { height: 10rpx; background: #ffe3e0; border-radius: 5rpx; overflow: hidden; }
.seckill-bar-fill { height: 100%; background: #ff3b30; border-radius: 5rpx; }
.seckill-sold { font-size: 18rpx; margin-top: 2rpx; }

.section-title { font-size: 30rpx; font-weight: 700; padding: 16rpx 28rpx; }
.goods-grid { display: flex; flex-wrap: wrap; justify-content: space-between; padding: 0 24rpx; }
.goods-cell { width: 48%; background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; padding: 12rpx; position: relative; }
.cell-pic { width: 100%; height: 240rpx; }
.cell-name { font-size: 26rpx; font-weight: 600; margin-top: 10rpx; line-height: 1.4; height: 72rpx; overflow: hidden; }
.cell-sub { font-size: 20rpx; margin-top: 4rpx; }
.cell-tags { margin-top: 4rpx; min-height: 28rpx; }
.cell-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.cell-add { width: 44rpx; height: 44rpx; border-radius: 50%; background: #ff3b30; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 30rpx; }

.nomore { text-align: center; color: #bbb; font-size: 24rpx; padding: 30rpx 0; }
.loading-more { text-align: center; color: #999; font-size: 24rpx; padding: 20rpx 0; }

.cd-inline { display: flex; align-items: center; font-size: 22rpx; margin-left: 12rpx; }
.cd-num { background: #333; color: #fff; border-radius: 6rpx; padding: 2rpx 8rpx; margin: 0 2rpx; font-weight: 700; }
.seckill-more { margin-left: auto; font-size: 22rpx; color: #999; }
