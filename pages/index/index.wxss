.page { padding-bottom: 40rpx; }

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
}
.s-icon { font-size: 28rpx; margin-right: 10rpx; }
.s-ph { flex: 1; color: #b0b0b0; font-size: 26rpx; }
.s-cat {
  background: #fdecec;
  color: #e93b3d;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

/* banner */
.banner { margin: 0 24rpx; border-radius: 16rpx; overflow: hidden; height: 320rpx; }
.banner-img { width: 100%; height: 320rpx; border-radius: 16rpx; }

/* 金刚区 */
.lantern { display: flex; flex-wrap: wrap; padding: 24rpx 12rpx; }
.lantern-item { width: 25%; text-align: center; padding: 12rpx 0; }
.lantern-img { width: 72rpx; height: 72rpx; }
.lantern-name { font-size: 24rpx; color: #333; margin-top: 8rpx; }

/* 区块标题 */
.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 8rpx;
}
.st-left { font-size: 32rpx; font-weight: bold; }
.st-sub { font-size: 24rpx; color: #b0b0b0; }

/* 商品卡片 */
.goods-card .add-btn {
  width: 52rpx; height: 52rpx;
  line-height: 48rpx; text-align: center;
  background: #e93b3d; color: #fff;
  border-radius: 50%; font-size: 36rpx;
  font-weight: bold; flex-shrink: 0;
}
.tag-row { margin-top: 6rpx; }
.flex1 { flex: 1; }

/* 限时抢购模块 */
.seckill-module { background: #fff; margin: 16rpx 24rpx; border-radius: 16rpx; padding: 20rpx; }
.sec-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.sec-title { font-size: 30rpx; font-weight: bold; color: #e93b3d; }
.sec-more { font-size: 24rpx; color: #838383; }
.sec-scroll { white-space: nowrap; }
.sec-card {
  display: inline-block;
  width: 180rpx;
  margin-right: 16rpx;
  vertical-align: top;
  text-align: center;
}
.sec-card image { width: 180rpx; height: 180rpx; border-radius: 12rpx; background: #f0f0f0; }
.sec-price-row { display: flex; justify-content: center; align-items: baseline; gap: 8rpx; margin-top: 6rpx; }
.sec-price { color: #e93b3d; font-weight: bold; font-size: 28rpx; }
.sec-progress { height: 10rpx; background: #f0f0f0; border-radius: 999rpx; overflow: hidden; margin-top: 6rpx; }
.sec-progress-fill { height: 100%; background: linear-gradient(90deg, #e93b3d, #ff8a80); border-radius: 999rpx; }
.sec-sold { font-size: 18rpx; color: #b0b0b0; margin-top: 4rpx; }
.sec-buy {
  display: inline-block;
  margin-top: 8rpx;
  background: #e93b3d; color: #fff;
  font-size: 22rpx; padding: 4rpx 24rpx; border-radius: 999rpx;
}
