/* 首页 */
.search-bar {
  display: flex; align-items: center; padding: 16rpx 24rpx;
  background: #fff; position: sticky; top: 0; z-index: 20;
}
.search-icon { width: 32rpx; height: 32rpx; margin-right: 12rpx; }
.search-placeholder { color: #999; font-size: 26rpx; }

.banner { width: calc(100% - 48rpx); margin: 16rpx 24rpx; height: 320rpx; border-radius: 16rpx; overflow: hidden; }
.banner image { width: 100%; height: 100%; }

.cat-grid { display: flex; flex-wrap: wrap; padding: 20rpx 10rpx; }
.cat-item { width: 25%; display: flex; flex-direction: column; align-items: center; padding: 10rpx 0; }
.cat-item image { width: 72rpx; height: 72rpx; }
.cat-item text { font-size: 24rpx; margin-top: 8rpx; color: #333; }

.tile-row { display: flex; padding: 16rpx 10rpx; }
.tile-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.tile-item image { width: 64rpx; height: 64rpx; }
.tile-item text { font-size: 24rpx; margin-top: 6rpx; }

.section-title { display: flex; justify-content: center; padding: 16rpx 0 4rpx; }
.section-title image { width: 240rpx; height: auto; }

.tag-row { margin-top: 8rpx; }
.add-btn {
  width: 48rpx; height: 48rpx; line-height: 44rpx; text-align: center;
  border-radius: 50%; background: #e4393c; color: #fff; font-size: 36rpx;
}
.price-box { display: flex; align-items: baseline; gap: 10rpx; }

.list-footer { text-align: center; color: #999; padding: 30rpx; font-size: 24rpx; }

/* 限时抢购模块 */
.seckill-module { padding: 16rpx; }
.seckill-head { display: flex; align-items: center; margin-bottom: 12rpx; }
.seckill-title { font-size: 30rpx; font-weight: 700; color: #e4393c; }
.seckill-countdown {
  margin-left: 16rpx; background: #333; color: #fff; font-size: 22rpx;
  padding: 4rpx 12rpx; border-radius: 6rpx; letter-spacing: 1rpx;
}
.seckill-more { margin-left: auto; color: #999; font-size: 24rpx; }
.seckill-scroll { white-space: nowrap; }
.seckill-card {
  display: inline-block; width: 140rpx; margin-right: 14rpx;
  position: relative; text-align: center;
}
.seckill-img { width: 140rpx; height: 140rpx; border-radius: 12rpx; }
.seckill-price { color: #e4393c; font-weight: 700; font-size: 26rpx; margin-top: 6rpx; }
.seckill-origin { color: #999; font-size: 18rpx; text-decoration: line-through; }
.seckill-progress { height: 8rpx; background: #f2f3f5; border-radius: 999rpx; margin-top: 4rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #e4393c, #ff9500); border-radius: 999rpx; }
.seckill-buy {
  position: absolute; right: 0; bottom: 30rpx; width: 40rpx; height: 40rpx;
  line-height: 36rpx; text-align: center; border-radius: 50%;
  background: #e4393c; color: #fff; font-size: 24rpx;
}

/* 骨架屏 */
.banner-skeleton { height: 320rpx; margin: 16rpx 24rpx; border-radius: 16rpx; }
.grid-skeleton { height: 120rpx; margin: 0 24rpx; }
.info-skeleton { flex: 1; height: 160rpx; margin-left: 20rpx; }
