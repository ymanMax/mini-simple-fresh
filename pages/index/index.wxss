/* 首页样式 */
.search-bar {
  margin: 16rpx 24rpx; height: 72rpx; background: #fff; border-radius: 999rpx;
  display: flex; align-items: center; padding: 0 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.search-icon { width: 32rpx; height: 32rpx; margin-right: 12rpx; }
.search-placeholder { color: #999; font-size: 26rpx; }

.banner { width: calc(100% - 48rpx); height: 300rpx; margin: 0 24rpx; border-radius: 16rpx; overflow: hidden; }
.banner-img { width: 100%; height: 300rpx; }

.lanternArea { display: flex; justify-content: space-around; padding: 24rpx 16rpx; }
.lantern-item { display: flex; flex-direction: column; align-items: center; width: 20%; }
.lantern-icon { width: 72rpx; height: 72rpx; }
.lantern-name { font-size: 22rpx; margin-top: 8rpx; color: #333; }

.tileArea { display: flex; gap: 16rpx; padding: 16rpx; }
.tile-item { flex: 1; display: flex; flex-direction: column; align-items: center; background: #fafafa; border-radius: 12rpx; padding: 16rpx; }
.tile-icon { width: 56rpx; height: 56rpx; }
.tile-name { font-size: 22rpx; margin-top: 6rpx; }

.section-title { display: flex; align-items: center; margin: 16rpx 24rpx; font-size: 30rpx; font-weight: 700; color: #333; }
.hot-icon { width: 40rpx; height: 40rpx; margin-right: 8rpx; }

/* 首页限时抢购模块（需求9.3） */
.seckill-home { padding: 16rpx 20rpx; }
.seckill-title { font-size: 30rpx; font-weight: 800; color: #e4393c; }
.countdown-mini { font-size: 26rpx; font-weight: 700; color: #e4393c; font-family: monospace; background: #fff1f0; padding: 4rpx 14rpx; border-radius: 999rpx; }
.more-link { font-size: 24rpx; color: #999; }
.home-seckill-card { width: 170rpx; padding: 10rpx; background: #fafafa; border-radius: 12rpx; margin-right: 12rpx; flex-shrink: 0; }
.home-seckill-img { width: 100%; height: 130rpx; border-radius: 8rpx; background: #f2f3f5; }
.home-seckill-name { font-size: 22rpx; margin: 6rpx 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.seckill-price { font-size: 28rpx; font-weight: 800; }
.progress-bar { width: 100%; height: 10rpx; background: #f2f3f5; border-radius: 999rpx; margin: 6rpx 0; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #e4393c, #ff7875); border-radius: 999rpx; }
.seckill-mini-btn { background: #e4393c; color: #fff; font-size: 18rpx; padding: 4rpx 14rpx; border-radius: 999rpx; }

.goods-list { padding-bottom: 20rpx; }
.add-btn {
  width: 52rpx; height: 52rpx; border-radius: 50%; background: #e4393c; color: #fff;
  display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: bold;
}
.tag-row { margin: 8rpx 0; }
.nomore { text-align: center; color: #999; font-size: 24rpx; padding: 24rpx; }
