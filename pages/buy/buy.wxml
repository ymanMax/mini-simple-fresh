<view class="buy-page" wx:if="{{!loading}}">
  <view class="empty-page" wx:if="{{!items.length}}">
    <image src="/images/empty-cart.jpg"></image>
    <view class="empty-title">没有待结算的商品</view>
    <view class="empty-desc">购物车为空，请先挑选商品</view>
    <view class="empty-btn" bindtap="goHome">去逛逛</view>
  </view>

  <!-- 收货地址 -->
  <block wx:if="{{items.length}}">
  <view class="card address-card" bindtap="goAddress">
    <block wx:if="{{address}}">
      <view class="addr-top">
        <text class="addr-name">{{address.name}}</text>
        <text class="addr-phone">{{address.phone}}</text>
        <text class="tag" wx:if="{{address.isDefault}}">默认</text>
        <text class="tag tag-gray">{{address.tag}}</text>
      </view>
      <view class="addr-detail">{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</view>
    </block>
    <view class="addr-none" wx:else>
      <view>＋ 添加收货地址</view>
    </view>
    <view class="addr-arrow">›</view>
  </view>

  <!-- 商品清单 -->
  <view class="card">
    <view class="block-title">商品清单（{{items.length}}）</view>
    <view class="buy-item" wx:for="{{items}}" wx:key="id || goodsId">
      <image class="bi-pic" src="{{item.pic}}" mode="aspectFill" binderror="imgError" data-list="items" data-index="{{index}}" data-field="pic"></image>
      <view class="bi-info">
        <view class="bi-name">{{item.name}}</view>
        <view class="bi-spec">{{item.specText}} × {{item.count}}</view>
      </view>
      <view class="bi-price price">￥{{item.priceYuan}}</view>
    </view>
  </view>

  <!-- 配送时间 -->
  <view class="card">
    <view class="block-title">配送时间</view>
    <view class="slot-toggle">
      <view class="slot-tab {{deliveryMode==='fast'?'on':''}}" bindtap="toggleSlots" data-mode="fast">尽快送达</view>
      <view class="slot-tab {{deliveryMode==='reserve'?'on':''}}" bindtap="toggleSlots">预约配送</view>
    </view>
    <view class="selected-slot" bindtap="toggleSlots">
      <text>{{selectedSlot}}</text>
      <text class="arrow">⌄</text>
    </view>
    <view class="slot-list" wx:if="{{showSlots}}">
      <view
        class="slot-item {{selectedSlot === item ? 'on' : ''}}"
        wx:for="{{slots}}" wx:key="*this"
        data-slot="{{item}}" bindtap="pickSlot">
        {{item}}
      </view>
    </view>
  </view>

  <!-- 优惠券 -->
  <view class="card row-line" bindtap="openCoupon">
    <text class="row-label">优惠券</text>
    <view class="row-right">
      <text wx:if="{{selectedCouponId}}" class="coupon-on">-￥{{discountYuan}}</text>
      <text wx:else class="sub">未使用</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 支付方式 -->
  <view class="card">
    <view class="block-title">支付方式</view>
    <view class="pay-row" bindtap="setPay" data-type="1">
      <view class="radio {{payType===1?'on':''}}"></view>
      <text class="pay-icon">💚</text>
      <text>微信支付（演示）</text>
    </view>
    <view class="pay-row" bindtap="setPay" data-type="2">
      <view class="radio {{payType===2?'on':''}}"></view>
      <text class="pay-icon">📦</text>
      <text>货到付款</text>
    </view>
  </view>

  <!-- 订单备注 -->
  <view class="card">
    <view class="block-title">订单备注（50字以内）</view>
    <input class="remark" placeholder="选填，如：不要放辣 / 放在门口" value="{{remark}}" bindinput="onRemark" maxlength="50" />
  </view>

  <!-- 金额明细：商品总价 - 满减 - 优惠券 + 配送费 -->
  <view class="card amount-card">
    <view class="amount-row"><text>商品总价</text><text>￥{{totalYuan}}</text></view>
    <view class="amount-row" wx:if="{{fullReduce > 0}}">
      <text>满减优惠（自动）</text><text class="price">-￥{{fullReduceYuan}}</text>
    </view>
    <view class="amount-row"><text>优惠券（{{selectedCouponId ? '已使用' : '未使用'}}）</text><text class="price">-￥{{discountYuan}}</text></view>
    <view class="amount-row"><text>配送费{{freight === 0 ? '（已满59免配送费）' : ''}}</text><text>￥{{freightYuan}}</text></view>
    <view class="amount-row total-row">
      <text>应付金额</text>
      <text class="price price-big">￥{{payAmountYuan}}</text>
    </view>
    <view class="demo-note">演示环境，不产生真实交易</view>
  </view>

  </block>

  <view style="height: 140rpx;" wx:if="{{items.length}}"></view>

  <!-- 底部提交栏 -->
  <view class="submit-bar" wx:if="{{items.length}}">
    <view class="sb-total">
      <text class="sb-label">应付</text>
      <text class="price price-big">￥{{payAmountYuan}}</text>
    </view>
    <view class="sb-btn {{submitting ? 'disabled' : ''}}" bindtap="submit">{{submitting ? '处理中...' : '提交订单'}}</view>
  </view>

  <!-- 优惠券弹层 -->
  <view class="mask" wx:if="{{couponSheet}}" bindtap="closeCoupon"></view>
  <view class="coupon-panel {{couponSheet ? 'show' : ''}}">
    <view class="panel-title">选择优惠券</view>
    <scroll-view scroll-y class="coupon-scroll">
      <view class="coupon-item {{c.usable ? '' : 'disabled'}}" wx:for="{{couponList}}" wx:key="id">
        <view class="coupon-left">
          <view class="coupon-val">{{c.amountText}}</view>
          <view class="coupon-threshold">{{c.ruleText}}</view>
        </view>
        <view class="coupon-mid">
          <view class="coupon-name">{{c.name}}</view>
          <view class="coupon-scope">{{c.scope}} · {{c.source}}</view>
          <view class="coupon-effect" wx:if="{{c.usable}}">立减 ￥{{c.effectYuan}}</view>
          <view class="coupon-reason" wx:else>{{c.reason || '不可用'}}</view>
        </view>
        <view class="coupon-use {{selectedCouponId === c.id ? 'used' : ''}}" data-id="{{c.id}}" bindtap="pickCoupon">
          {{selectedCouponId === c.id ? '已选' : (c.usable ? '使用' : '不可用')}}
        </view>
      </view>
      <view class="no-coupon" bindtap="noCoupon">不使用优惠券</view>
    </scroll-view>
  </view>
</view>

<!-- 骨架 -->
<view class="skeleton" wx:if="{{loading}}">
  <view class="sk-row"><view class="sk-line w80"></view></view>
  <view class="sk-row"><view class="sk-block sk-img"></view><view class="flex1"><view class="sk-line w80"></view><view class="sk-line w60"></view></view></view>
</view>
