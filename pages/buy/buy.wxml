<!-- 订单确认页：地址、商品清单、配送时间、优惠券、支付方式、金额明细、提交 -->
<view class="page-wrap buy-page">
  <!-- 骨架屏 -->
  <view wx:if="{{loading}}" class="skeleton">
    <view class="sk-block" style="height:160rpx"></view>
    <view class="sk-block" style="height:200rpx"></view>
    <view class="sk-block" style="height:240rpx"></view>
  </view>

  <block wx:else>
    <!-- 收货地址 -->
    <view class="card address-card" bindtap="goChooseAddress">
      <block wx:if="{{address}}">
        <view class="row-between">
          <view class="row">
            <view class="addr-name">{{address.name}}</view>
            <view class="addr-phone">{{address.phone}}</view>
            <view class="tag">{{address.tag}}</view>
          </view>
          <view class="muted">更换 ›</view>
        </view>
        <view class="addr-detail">{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</view>
      </block>
      <block wx:else>
        <view class="row-between">
          <view class="muted">添加收货地址</view>
          <view class="muted">去添加 ›</view>
        </view>
      </block>
    </view>

    <!-- 商品清单 -->
    <view class="card">
      <view class="section-title-sm">商品清单（{{items.length}}）</view>
      <view class="order-item" wx:for="{{items}}" wx:key="goodsId">
        <image class="order-img" src="{{item.pic}}" mode="aspectFill" binderror="onImgError" data-key="items[{{index}}].pic"></image>
        <view class="flex-1">
          <view class="order-name">{{item.name}}</view>
          <view class="muted small">{{item.specText}}</view>
          <view class="row-between" style="margin-top:8rpx">
            <view class="price-sm">¥{{item.price/100}}</view>
            <view class="muted">×{{item.count}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 配送时间 -->
    <view class="card">
      <view class="section-title-sm">配送时间</view>
      <view class="delivery-tabs">
        <view class="delivery-tab {{deliveryType=='fast'?'active':''}}" bindtap="chooseDeliveryType" data-type="fast">尽快送达（预计45分钟）</view>
        <view class="delivery-tab {{deliveryType=='appoint'?'active':''}}" bindtap="chooseDeliveryType" data-type="appoint">预约配送</view>
      </view>
      <view class="slot-list" wx:if="{{deliveryType=='appoint'}}">
        <view class="slot {{deliverySlot==s?'active':''}}" wx:for="{{slots}}" wx:key="*this" bindtap="chooseSlot" data-slot="{{s}}">{{s}}</view>
      </view>
    </view>

    <!-- 优惠券 -->
    <view class="card" bindtap="openCouponPanel">
      <view class="row-between">
        <view class="section-title-sm" style="margin:0">优惠券</view>
        <view wx:if="{{selectedCoupon}}" class="active-red">{{selectedCoupon.name}}（-¥{{discount/100}}）›</view>
        <view wx:else class="muted">暂无可用 ›</view>
      </view>
    </view>

    <!-- 支付方式 -->
    <view class="card">
      <view class="section-title-sm">支付方式</view>
      <view class="pay-row {{payType==1?'active':''}}" bindtap="choosePay" data-type="1">
        <view class="radio {{payType==1?'checked':''}}"></view>
        <image class="pay-icon" src="/images/icons/mp.png" binderror="onImgError" data-key="wechatIcon"></image>
        <text>微信支付（默认）</text>
      </view>
      <view class="pay-row {{payType==2?'active':''}}" bindtap="choosePay" data-type="2">
        <view class="radio {{payType==2?'checked':''}}"></view>
        <image class="pay-icon" src="/images/icons/card_bag.png" binderror="onImgError" data-key="codIcon"></image>
        <text>货到付款</text>
      </view>
    </view>

    <!-- 订单备注 -->
    <view class="card">
      <view class="section-title-sm">订单备注</view>
      <input class="remark-input" placeholder="选填，最多50字" value="{{remark}}" bindinput="onRemarkInput" maxlength="50" />
    </view>

    <!-- 金额明细：商品总价 - 满减优惠 - 优惠券优惠 + 配送费 = 应付（需求9.2拆分） -->
    <view class="card">
      <view class="amount-row"><text class="muted">商品总价</text><text>¥{{goodsTotal/100}}</text></view>
      <view class="amount-row" wx:if="{{fullReduce>0}}"><text class="muted">满减优惠</text><text class="active-red">-¥{{fullReduce/100}}</text></view>
      <view class="amount-row" wx:if="{{couponDiscount>0}}"><text class="muted">优惠券（{{selectedCoupon.name}}）</text><text class="active-red">-¥{{couponDiscount/100}}</text></view>
      <view class="amount-row" wx:if="{{fullReduce==0 && couponDiscount==0 && discount>0}}"><text class="muted">优惠抵扣</text><text class="active-red">-¥{{discount/100}}</text></view>
      <view class="amount-row"><text class="muted">配送费</text><text>{{freightText}}</text></view>
      <view class="divider"></view>
      <view class="amount-row total"><text>应付金额</text><text class="price">¥{{payAmount/100}}</text></view>
    </view>

    <!-- 促销提示：可享满减 -->
    <view class="card promo-tip" wx:if="{{fullReduce>0}}">
      <view class="muted small">{{fullReduceTip}}</view>
    </view>
  </block>

  <!-- 底部提交栏 -->
  <view wx:if="{{!loading}}" class="checkout-bar">
    <view class="flex-1 total-box">
      <view class="total-text">应付：<text class="price">¥{{payAmount/100}}</text></view>
    </view>
    <view class="submit-btn {{submitting?'btn-disabled':''}}" bindtap="submitOrder">{{submitting?'提交中...':'提交订单'}}</view>
  </view>
</view>

<!-- 优惠券选择面板 -->
<view class="coupon-mask" wx:if="{{showCouponPanel}}" bindtap="closeCouponPanel">
  <view class="coupon-panel" catchtap="">
    <view class="panel-title">选择优惠券</view>
    <scroll-view scroll-y style="max-height:60vh">
      <view class="coupon-item {{item.usable?'':'disabled'}}" wx:for="{{couponList}}" wx:key="id" bindtap="chooseCoupon" data-id="{{item.id}}">
        <view class="coupon-left">
          <view class="coupon-amount">{{item.amountText}}</view>
          <view class="coupon-name">{{item.name}}</view>
        </view>
        <view class="coupon-right">
          <view class="muted small">{{item.scope}}</view>
          <view class="muted small">有效期至 {{item.expireTime}}</view>
          <view class="coupon-use">{{item.usable?'去使用':'不可用'}}</view>
        </view>
      </view>
      <view wx:if="{{couponList.length==0}}" class="muted" style="text-align:center;padding:40rpx">暂无优惠券</view>
    </scroll-view>
    <view class="panel-cancel" bindtap="closeCouponPanel">关闭</view>
  </view>
</view>
