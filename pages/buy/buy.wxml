<view class="buy-page">
  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk-row"><view class="sk-img" style="width:100%;height:120rpx"></view></view>
    <view class="sk-row"><view class="sk-img" style="width:150rpx;height:150rpx"></view><view class="sk-body"><view class="sk-line" style="width:70%"></view><view class="sk-line" style="width:45%"></view></view></view>
  </view>

  <block wx:else>
    <!-- 收货地址 -->
    <view class="card addr-card" bindtap="goAddress">
      <block wx:if="{{address}}">
        <view class="addr-row">
          <view class="addr-name">{{address.name}}</view>
          <view class="addr-phone">{{address.phone}}</view>
          <view class="tag">{{address.tag}}</view>
        </view>
        <view class="addr-detail">{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</view>
      </block>
      <view class="addr-empty" wx:else>
        <view>📍 请选择收货地址</view>
        <view class="addr-go">去添加 ›</view>
      </view>
    </view>

    <!-- 配送时间 -->
    <view class="card">
      <view class="seg-tabs">
        <view class="seg {{deliveryMode === 'now' ? 'on' : ''}}" bindtap="setDeliveryMode" data-mode="now">尽快送达（预计45分钟）</view>
        <view class="seg {{deliveryMode === 'book' ? 'on' : ''}}" bindtap="setDeliveryMode" data-mode="book">预约配送</view>
      </view>
      <view class="slots" wx:if="{{deliveryMode === 'book'}}">
        <view class="slot {{slotIndex === idx ? 'on' : ''}}" wx:for="{{slots}}" wx:key="*this" wx:for-index="idx" bindtap="pickSlot" data-idx="{{idx}}">{{item}}</view>
      </view>
    </view>

    <!-- 商品清单 -->
    <view class="card">
      <view class="section-title">商品清单</view>
      <view class="order-item" wx:for="{{items}}" wx:key="sku">
        <pic src="{{item.pic}}" mode="aspectFill" radius="10rpx" class="oi-pic"/>
        <view class="oi-info">
          <view class="oi-name">{{item.name}}</view>
          <view class="muted">{{item.specText}} · {{item.unit}}</view>
          <view class="oi-bottom">
            <view class="price-sm primary">￥{{item.priceYuan}}</view>
            <view class="muted">x{{item.count}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 优惠券 -->
    <view class="card row-card" bindtap="openCoupon">
      <view class="row-label">优惠券</view>
      <view class="row-value {{selectedCoupon ? 'primary' : 'muted'}}">
        {{selectedCoupon ? selectedCoupon.name : '暂无可用'}} ›
      </view>
    </view>

    <!-- 支付方式 -->
    <view class="card">
      <view class="section-title">支付方式</view>
      <view class="pay-row" bindtap="setPayType" data-type="1">
        <view class="radio {{payType === 1 ? 'on' : ''}}">{{payType === 1 ? '✓' : ''}}</view>
        <view class="pay-icon">💚</view>
        <view class="pay-name">微信支付</view>
        <view class="muted">推荐使用</view>
      </view>
      <view class="pay-row" bindtap="setPayType" data-type="2">
        <view class="radio {{payType === 2 ? 'on' : ''}}">{{payType === 2 ? '✓' : ''}}</view>
        <view class="pay-icon">📦</view>
        <view class="pay-name">货到付款</view>
      </view>
    </view>

    <!-- 备注 -->
    <view class="card">
      <view class="section-title">订单备注</view>
      <input class="remark-input" value="{{remark}}" placeholder="选填，最多50字" bindinput="onRemarkInput" maxlength="50"/>
      <view class="muted remark-count">{{remarkLen}}/50</view>
    </view>

    <!-- 金额明细 -->
    <view class="card">
      <view class="money-row"><text>商品总价</text><text>￥{{totalYuan}}</text></view>
      <view class="money-row" wx:if="{{fullReduction > 0}}"><text>满减优惠（自动）</text><text class="primary">-￥{{fullReductionYuan}}</text></view>
      <view class="money-row" wx:if="{{discount > 0}}"><text>优惠券优惠{{selectedCoupon ? '（' + selectedCoupon.name + '）' : ''}}</text><text class="primary">-￥{{discountYuan}}</text></view>
      <view class="money-row"><text>配送费</text><text>{{freight === 0 ? '免配送费' : '￥' + freightYuan}}</text></view>
      <view class="money-row total-row"><text>应付金额</text><text class="price">￥{{payAmountYuan}}</text></view>
    </view>

    <!-- 底部提交栏 -->
    <view class="footer-bar">
      <view class="total-box">
        <view class="muted">合计</view>
        <view class="price big">￥{{payAmountYuan}}</view>
      </view>
      <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submit">{{submitting ? '提交中…' : '提交订单'}}</view>
    </view>
  </block>

  <!-- 优惠券弹层 -->
  <view class="mask" wx:if="{{showCoupon}}" bindtap="closeCoupon"></view>
  <view class="coupon-sheet" wx:if="{{showCoupon}}">
    <view class="sheet-head">
      <view class="sheet-title">选择优惠券</view>
      <view class="sheet-close" bindtap="closeCoupon">✕</view>
    </view>
    <scroll-view scroll-y class="coupon-list">
      <view class="coupon-item {{item.usable ? '' : 'disabled'}}" wx:for="{{coupons}}" wx:key="id" bindtap="pickCoupon" data-id="{{item.id}}">
        <view class="coupon-left">
          <view class="coupon-amount">{{item.discountText}}</view>
          <view class="muted">{{item.conditionText}}</view>
        </view>
        <view class="coupon-right">
          <view class="coupon-name">{{item.name}}</view>
          <view class="muted">{{item.scope}} · {{item.expireTime}}</view>
          <view class="coupon-reason" wx:if="{{!item.usable}}">{{item.reason}}</view>
        </view>
        <view class="coupon-select {{selectedCoupon.id === item.id ? 'on' : ''}}">
          {{selectedCoupon.id === item.id ? '已选' : (item.usable ? '使用' : '不可用')}}
        </view>
      </view>
      <view class="no-coupon" bindtap="noCoupon">不使用优惠券</view>
    </scroll-view>
  </view>

  <!-- 支付 loading -->
  <view class="pay-mask" wx:if="{{payLoading}}">
    <view class="pay-box">
      <view class="pay-spinner"></view>
      <view class="pay-text">正在调起微信支付…</view>
      <view class="pay-tip">演示环境，不产生真实交易</view>
    </view>
  </view>
</view>
