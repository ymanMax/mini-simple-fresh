/**app.wxss**/
/* ============ 全局设计规范：红色主题，页面背景 #f5f6f7，卡片白底圆角16rpx ============ */
page {
  background: #f5f6f7;
  font-size: 28rpx;
  color: #333;
  -webkit-font-smoothing: antialiased;
}
view, text, image, input, button { box-sizing: border-box; }
image { display: block; }

/* 主题色 */
.primary { color: #ff3b30; }
.bg-primary { background: #ff3b30; }

/* 页面容器 */
.page { min-height: 100vh; padding-bottom: 140rpx; }
.page-nopad { min-height: 100vh; }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(90deg,#ff5b4f,#ff3b30);
  color: #fff; border-radius: 44rpx; text-align: center;
  font-size: 30rpx; padding: 20rpx 0; border: none;
}
.btn-primary::after { border: none; }
.btn-primary[disabled] { background: #ffb3ad; color: #fff; }
.btn-ghost {
  background: #fff; color: #ff3b30; border: 2rpx solid #ff3b30;
  border-radius: 44rpx; text-align: center; font-size: 28rpx; padding: 16rpx 0;
}
.btn-ghost::after { border: none; }
.btn-block { width: calc(100% - 48rpx); margin: 0 24rpx; }

/* 价格 */
.price { color: #ff3b30; font-weight: 700; font-size: 34rpx; }
.price::before { content: '￥'; font-size: 24rpx; margin-right: 2rpx; }
.price-sm { color: #ff3b30; font-weight: 700; font-size: 28rpx; }
.price-sm::before { content: '￥'; font-size: 20rpx; }
.price-origin { color: #bbb; font-size: 24rpx; text-decoration: line-through; margin-left: 8rpx; }

/* 标签胶囊 */
.tag {
  display: inline-block; font-size: 20rpx; padding: 2rpx 12rpx;
  border-radius: 8rpx; background: #fff1f0; color: #ff3b30;
  margin-right: 8rpx; line-height: 1.7;
}
.tag-green { background: #e8f7ef; color: #12b76a; }
.tag-gray { background: #f0f0f0; color: #999; }

/* 空状态 */
.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.empty-img { width: 200rpx; height: 200rpx; border-radius: 24rpx; background: #e9edf2; display:flex; align-items:center; justify-content:center; font-size:80rpx; }
.empty-text { color: #999; font-size: 26rpx; margin-top: 20rpx; text-align: center; }
.empty-btn { margin-top: 30rpx; background: #ff3b30; color: #fff; padding: 14rpx 48rpx; border-radius: 36rpx; font-size: 26rpx; }

/* 骨架屏 */
.skeleton { padding: 24rpx; }
.sk-row { display: flex; margin-bottom: 24rpx; }
.sk-img { width: 180rpx; height: 180rpx; border-radius: 12rpx; background: linear-gradient(90deg,#eceef1 25%,#f6f7f9 50%,#eceef1 75%); background-size: 400% 100%; animation: breathe 1.4s ease-in-out infinite; }
.sk-body { flex: 1; margin-left: 20rpx; }
.sk-line { height: 24rpx; border-radius: 6rpx; margin-bottom: 14rpx; background: linear-gradient(90deg,#eceef1 25%,#f6f7f9 50%,#eceef1 75%); background-size: 400% 100%; animation: breathe 1.4s ease-in-out infinite; }
@keyframes breathe { 0%{background-position:100% 0} 100%{background-position:0 0} }

/* stepper 数量 */
.stepper { display: flex; align-items: center; }
.stepper .minus, .stepper .plus {
  width: 48rpx; height: 48rpx; border-radius: 50%; background: #fff;
  border: 2rpx solid #ddd; display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; color: #666;
}
.stepper .plus { background: #ff3b30; border-color: #ff3b30; color: #fff; }
.stepper .num { width: 60rpx; text-align: center; font-size: 30rpx; font-weight: 600; }

/* 角标 */
.badge {
  position: absolute; top: -8rpx; right: -6rpx; min-width: 32rpx; height: 32rpx;
  background: #ff3b30; color: #fff; border-radius: 16rpx; font-size: 20rpx;
  display: flex; align-items: center; justify-content: center; padding: 0 8rpx;
}

/* 分隔线 */
.divider { height: 16rpx; background: #f5f6f7; }

/* 列表项 */
.list-item { display: flex; align-items: center; padding: 24rpx; background: #fff; }
.muted { color: #999; font-size: 24rpx; }

/* 底部固定栏 */
.footer-bar {
  position: fixed; left: 0; right: 0; bottom: 0; background: #fff;
  padding: 16rpx 24rpx; display: flex; align-items: center;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.06); z-index: 100;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.footer-bar .total { flex: 1; font-size: 26rpx; }
.footer-bar .total .price { font-size: 38rpx; }
.checkbox {
  width: 40rpx; height: 40rpx; border-radius: 50%; border: 2rpx solid #ccc;
  display: inline-flex; align-items: center; justify-content: center; font-size: 24rpx; color: #fff;
}
.checkbox.on { background: #ff3b30; border-color: #ff3b30; }

/* 顶部搜索栏 */
.search-bar {
  display: flex; align-items: center; background: #fff; margin: 16rpx 24rpx;
  border-radius: 36rpx; padding: 12rpx 24rpx;
}
.search-bar input { flex: 1; font-size: 26rpx; }

/* tab 行 */
.tabs { display: flex; background: #fff; position: sticky; top: 0; z-index: 50; }
.tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 27rpx; color: #666; position: relative; }
.tab.on { color: #ff3b30; font-weight: 700; }
.tab.on::after { content:''; position:absolute; bottom: 6rpx; left: 50%; transform: translateX(-50%); width: 40rpx; height: 6rpx; border-radius: 3rpx; background: #ff3b30; }

/* 通用商品卡（列表） */
.goods-card { display: flex; background: #fff; border-radius: 16rpx; margin: 0 24rpx 20rpx; padding: 20rpx; }
.goods-card .pic { width: 180rpx; height: 180rpx; border-radius: 12rpx; }
.goods-card .info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; }
.goods-card .name { font-size: 28rpx; font-weight: 600; line-height: 1.4; }
.goods-card .sub { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.goods-card .bottom { margin-top: auto; display: flex; align-items: center; justify-content: space-between; }

/* 图片兜底 */
.img-fallback { background: #e9edf2; }
