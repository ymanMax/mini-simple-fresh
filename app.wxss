/**app.wxss**/
/* ===== 设计规范 ===== */
page {
  background: #f5f6f7;
  color: #333;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

:root {
  --primary: #e93b3d;
  --primary-light: #fdecec;
  --text: #333;
  --text-sub: #838383;
  --bg: #f5f6f7;
  --card: #fff;
  --border: #eee;
}

/* ===== 通用卡片 ===== */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

/* ===== 主按钮 ===== */
.btn-primary {
  background: #e93b3d;
  color: #fff;
  border-radius: 999rpx;
  text-align: center;
  font-size: 30rpx;
  padding: 22rpx 0;
  border: none;
  line-height: 44rpx;
}
.btn-primary::after { border: none; }
.btn-plain {
  background: #fff;
  color: #e93b3d;
  border: 2rpx solid #e93b3d;
  border-radius: 999rpx;
  text-align: center;
  font-size: 28rpx;
  padding: 18rpx 0;
  line-height: 40rpx;
}
.btn-plain::after { border: none; }
.btn-disabled {
  background: #ddd;
  color: #fff;
  border-radius: 999rpx;
  text-align: center;
  font-size: 30rpx;
  padding: 22rpx 0;
  line-height: 44rpx;
}
.btn-disabled::after { border: none; }

/* ===== 价格 ===== */
.price {
  color: #e93b3d;
  font-weight: bold;
}
.price-big { font-size: 40rpx; }
.price-small { font-size: 24rpx; }
.price-origin {
  color: #b0b0b0;
  text-decoration: line-through;
  font-size: 24rpx;
  margin-left: 8rpx;
}

/* ===== 标签胶囊 ===== */
.tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #fdecec;
  color: #e93b3d;
  margin-right: 8rpx;
  line-height: 32rpx;
}
.tag-green { background: #e8f5e9; color: #43a047; }
.tag-gray { background: #f0f0f0; color: #838383; }

/* ===== 骨架屏 ===== */
.skeleton { padding: 24rpx; }
.sk-row {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.sk-block {
  background: #eee;
  border-radius: 12rpx;
}
.sk-img { width: 180rpx; height: 180rpx; flex-shrink: 0; margin-right: 24rpx; }
.sk-line { height: 28rpx; margin-bottom: 16rpx; border-radius: 8rpx; background: #eee; }
.sk-line.w60 { width: 60%; }
.sk-line.w40 { width: 40%; }
.sk-line.w80 { width: 80%; }
@keyframes breathe { 0%,100% { opacity: 1; } 50% { opacity: 0.55; } }
.sk-block, .sk-line { animation: breathe 1.4s ease-in-out infinite; }

/* ===== 空状态 ===== */
.empty-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx 60rpx;
}
.empty-page img { width: 280rpx; height: 280rpx; }
.empty-title { color: #838383; font-size: 28rpx; margin-top: 24rpx; text-align: center; }
.empty-desc { color: #b0b0b0; font-size: 24rpx; margin-top: 12rpx; text-align: center; }
.empty-btn {
  margin-top: 40rpx;
  background: #e93b3d;
  color: #fff;
  padding: 16rpx 56rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
}

/* ===== 列表底 ===== */
.list-end {
  text-align: center;
  color: #b0b0b0;
  font-size: 24rpx;
  padding: 32rpx 0;
}

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
}
.search-bar .s-icon { width: 28rpx; height: 28rpx; opacity: 0.5; }
.search-bar input { flex: 1; font-size: 28rpx; padding: 0 16rpx; }

/* ===== 商品卡片 ===== */
.goods-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin: 16rpx 24rpx;
  padding: 20rpx;
}
.goods-card .g-pic {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}
.goods-card .g-info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; justify-content: space-between; }
.goods-card .g-name { font-size: 28rpx; font-weight: 600; line-height: 1.4; }
.goods-card .g-sub { font-size: 22rpx; color: #838383; margin-top: 4rpx; }
.goods-card .g-bottom { display: flex; align-items: flex-end; justify-content: space-between; }

/* ===== 数字步进器 ===== */
.stepper { display: flex; align-items: center; }
.stepper .st-btn {
  width: 48rpx; height: 48rpx;
  line-height: 44rpx; text-align: center;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  font-size: 32rpx;
  color: #666;
}
.stepper .st-btn.active { border-color: #e93b3d; color: #e93b3d; }
.stepper .st-num { min-width: 56rpx; text-align: center; font-size: 28rpx; }

/* ===== 通用列表行 ===== */
.row-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

/* 角标 */
.badge-dot {
  position: absolute;
  top: -6rpx; right: -10rpx;
  min-width: 32rpx; height: 32rpx;
  background: #e93b3d;
  color: #fff;
  font-size: 20rpx;
  border-radius: 999rpx;
  text-align: center;
  line-height: 32rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.flex { display: flex; align-items: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.mt16 { margin-top: 16rpx; }
.mt24 { margin-top: 24rpx; }
.sub { color: #838383; font-size: 24rpx; }
