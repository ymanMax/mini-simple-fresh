/* app.wxss —— 全局红色主题样式：页面背景 #f5f6f7，卡片白底圆角16rpx，间距24rpx */
page {
  background: #f5f6f7;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  color: #333;
  -webkit-font-smoothing: antialiased;
}

view, text, image, input, button { box-sizing: border-box; }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.card-no-margin { margin: 0; }

/* 价格 */
.price { color: #e4393c; font-weight: bold; font-size: 32rpx; }
.price-sm { color: #e4393c; font-weight: bold; font-size: 28rpx; }
.price-origin { color: #999; text-decoration: line-through; font-size: 24rpx; margin-left: 8rpx; }

/* 按钮 */
.btn-primary {
  background: #e4393c; color: #fff; border-radius: 999rpx;
  padding: 18rpx 48rpx; font-size: 30rpx; text-align: center; border: none;
}
.btn-primary::after { border: none; }
.btn-plain {
  background: #fff; color: #e4393c; border: 1rpx solid #e4393c; border-radius: 999rpx;
  padding: 16rpx 40rpx; font-size: 28rpx; text-align: center;
}
.btn-disabled { background: #ccc !important; }

/* 标签胶囊 */
.tag {
  display: inline-block; background: #fff1f0; color: #e4393c;
  font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 999rpx; margin-right: 8rpx;
}
.tag-gray { background: #f2f3f5; color: #838383; }

/* 页面容器 */
.page-wrap { padding-bottom: 140rpx; }
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }
.muted { color: #999; font-size: 24rpx; }
.small { font-size: 24rpx; }

/* 骨架屏 */
.skeleton { padding: 24rpx; }
.sk-block {
  background: #e8e9eb; border-radius: 12rpx; margin-bottom: 16rpx;
  animation: breathe 1.2s ease-in-out infinite;
}
@keyframes breathe { 0%,100% { opacity: .55; } 50% { opacity: 1; } }

/* 空状态 */
.empty {
  padding: 120rpx 40rpx; text-align: center; color: #999;
}
.empty-img { width: 200rpx; height: 200rpx; margin: 0 auto 24rpx; border-radius: 16rpx; }
.empty-title { font-size: 30rpx; color: #666; margin-bottom: 12rpx; }
.empty-sub { font-size: 24rpx; color: #999; margin-bottom: 32rpx; }

/* 商品卡片 */
.goods-card {
  background: #fff; border-radius: 16rpx; margin: 16rpx 24rpx; padding: 20rpx;
  display: flex; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.goods-img {
  width: 160rpx; height: 160rpx; border-radius: 12rpx; flex-shrink: 0; background: #f2f3f5;
}
.goods-info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; justify-content: space-between; }
.goods-name { font-size: 28rpx; font-weight: 600; line-height: 1.4; }
.goods-sub { font-size: 22rpx; color: #999; margin-top: 6rpx; }

/* 数量步进器 */
.stepper { display: flex; align-items: center; }
.stepper-btn {
  width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center;
  border: 1rpx solid #ddd; border-radius: 50%; font-size: 32rpx; color: #666;
}
.stepper-num { width: 64rpx; text-align: center; font-size: 30rpx; font-weight: 600; }

/* 底部结算栏 */
.checkout-bar {
  position: fixed; left: 0; right: 0; bottom: 0; height: 100rpx;
  background: #fff; display: flex; align-items: center; padding: 0 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06); z-index: 100;
}

/* 角标 */
.badge {
  position: absolute; top: -8rpx; right: -8rpx; background: #e4393c; color: #fff;
  font-size: 18rpx; min-width: 32rpx; height: 32rpx; line-height: 32rpx;
  border-radius: 999rpx; text-align: center; padding: 0 6rpx;
}

/* 分割线 */
.divider { height: 1rpx; background: #f0f0f0; margin: 16rpx 0; }

/* 滚动横向列表 */
.h-scroll { display: flex; overflow-x: auto; padding: 10rpx 24rpx; white-space: nowrap; }
.h-scroll-item { flex-shrink: 0; margin-right: 16rpx; }

/* 选中态 */
.active-red { color: #e4393c !important; }
