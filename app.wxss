/* ============ 全局样式：红色主题 #e4393c，页面背景 #f5f6f7 ============ */
page {
  background: #f5f6f7;
  color: #333;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  box-sizing: border-box;
}
view, text, image, input, button { box-sizing: border-box; }

.page-bg { min-height: 100vh; background: #f5f6f7; padding-bottom: 140rpx; }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx;
}

/* 主题色 */
.theme-color { color: #e4393c; }
.theme-bg { background: #e4393c; }
.price-red { color: #e4393c; font-weight: bold; }
.price-num { color: #e4393c; font-weight: bold; font-size: 36rpx; }
.price-num::before { content: '¥'; font-size: 24rpx; margin-right: 2rpx; }
.price-old { color: #999; font-size: 24rpx; text-decoration: line-through; }

/* 按钮 */
.btn-primary {
  background: #e4393c; color: #fff; border-radius: 999rpx;
  text-align: center; padding: 20rpx 0; font-size: 30rpx; font-weight: 500;
}
.btn-primary[disabled] { background: #f5a8ab; }
.btn-ghost {
  background: #fff; color: #e4393c; border: 2rpx solid #e4393c;
  border-radius: 999rpx; text-align: center; padding: 18rpx 0; font-size: 28rpx;
}
.btn-white {
  background: #fff; color: #333; border-radius: 999rpx;
  text-align: center; padding: 18rpx 0; font-size: 28rpx;
}

/* 标签胶囊 */
.tag-pill {
  display: inline-block; padding: 4rpx 14rpx; border-radius: 8rpx;
  background: #fdecec; color: #e4393c; font-size: 20rpx; margin-right: 8rpx;
}
.tag-pill-gray { background: #f2f3f5; color: #838383; }

/* 数量步进器 */
.stepper { display: flex; align-items: center; }
.stepper-btn {
  width: 48rpx; height: 48rpx; line-height: 44rpx; text-align: center;
  border-radius: 50%; border: 2rpx solid #ddd; font-size: 32rpx; color: #666;
}
.stepper-btn.minus { color: #999; }
.stepper-num { min-width: 56rpx; text-align: center; font-size: 30rpx; }

/* 骨架屏 */
.skeleton { background: #eee; border-radius: 12rpx; animation: breath 1.2s ease-in-out infinite; }
@keyframes breath { 0%,100% { opacity: 0.55; } 50% { opacity: 1; } }

/* 空状态 */
.empty-box { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-img { width: 200rpx; height: 200rpx; border-radius: 16rpx; margin-bottom: 20rpx; }
.empty-text { color: #999; font-size: 26rpx; margin-bottom: 30rpx; }

/* 底部结算栏 */
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff; padding: 16rpx 24rpx;
  display: flex; align-items: center; justify-content: space-between;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06); z-index: 100;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

/* 商品图通用 */
.goods-img { width: 180rpx; height: 180rpx; border-radius: 12rpx; background: #f2f3f5; }

/* 分割线 */
.divider { height: 2rpx; background: #f2f3f5; margin: 16rpx 0; }

/* 文本省略 */
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ellipsis-2 { overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

/* 小红点 */
.red-dot {
  position: absolute; top: 0; right: 0; min-width: 28rpx; height: 28rpx;
  background: #e4393c; color: #fff; border-radius: 999rpx;
  font-size: 18rpx; line-height: 28rpx; text-align: center; padding: 0 6rpx;
}

/* 通用 flex */
.flex { display: flex; align-items: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-col { display: flex; flex-direction: column; }
.ml-auto { margin-left: auto; }

/* 商品列表卡片 */
.goods-card {
  display: flex; background: #fff; border-radius: 16rpx;
  padding: 20rpx; margin: 16rpx 24rpx;
}
.goods-card .info { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; }
.goods-name { font-size: 28rpx; font-weight: 500; }
.goods-sub { color: #999; font-size: 22rpx; margin-top: 6rpx; }
.goods-bottom { margin-top: auto; display: flex; align-items: flex-end; justify-content: space-between; }

/* 圆角图片兜底 */
img-fix, .img-fix { background: #f2f3f5; }
